+/* The transport the injection relies on: a live output that really carries
+ * RGB 8 bit samples, so the metadata bits in the least significant bits
+ * reach the TV unchanged.
+ */
+bool hdmitx_transport_is_live(void)
+{
+	return hdmitx_vsif_tx_ready() && hdmitx_transport_matches_policy();
+}
+EXPORT_SYMBOL(hdmitx_transport_is_live);
