+/*
+ * Called from the video sink when a frame updates the source format.  The
+ * timer already drives the injection, so this only makes sure it runs.
+ */
+void dv_injection_process_frame(struct vframe_s *vf)
+{
+	u8 *dv_sei = NULL;
+	u8 *hdr10p_sei = NULL;
+	u16 payload_len;
+	const u8 *payload;
+	struct dv_inj_slot *slot;
+	unsigned long flags;
+	u32 gen;
+	u32 dm_len = 0;
+	int ret;
+
+	if (!vf || !READ_ONCE(dv_injection_enable))
+		return;
+
+	/* R2/R5: take the producer lock first.  Everything that touches shared
+	 * scratch - the HDR10+ template, the generated DM, L1/L5 adjustments -
+	 * and the generation this frame belongs to is decided under it, so a
+	 * provider event cannot slip in between the parse and the publish.
+	 */
+	mutex_lock(&dv_injection_lock);
+	if (!READ_ONCE(dv_inj_stream_running)) {
+		mutex_unlock(&dv_injection_lock);
+		return;
+	}
+	gen = READ_ONCE(dv_inj_generation);
+
+	payload_len = search_sei_for_dynamic_metadata(vf->src_fmt.sei_ptr,
+						      vf->src_fmt.sei_size,
+						      &dv_sei, &hdr10p_sei);
+	payload = dv_sei;
+
+	if (!payload) {
+		if (!generate_DV_from_hdr10p || !hdr10p_sei) {
+			dv_inj_diag_producer(vf, vf->src_fmt.sei_size, NULL, 0, 0,
+					     -ENOENT, 0, 0, false);
+			slot = &dv_inj_pool[vf->index & (DV_INJ_POOL_SIZE - 1)];
+			spin_lock_irqsave(&dv_inj_publish_lock, flags);
+			WRITE_ONCE(slot->valid, false);
+			spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+			mutex_unlock(&dv_injection_lock);
+			return;
+		}
+		dv_injection_log(2, "dv injection: building DV metadata from HDR10+\n");
+		memcpy(dv_inj_hdr10p_dm, dv_inj_hdr10p_template,
+		       sizeof(dv_inj_hdr10p_dm));
+		form_dv_sei_payload_from_hdr10plus(hdr10p_sei, payload_len,
+						   dv_inj_hdr10p_dm,
+						   vf->prop.master_display_colour.luminance[0],
+						   vf->prop.master_display_colour.luminance[1]);
+		payload = dv_inj_hdr10p_dm;
+		payload_len = HDR10PLUS_DV_PAYLOAD_SIZE;
+		vf->src_fmt.fmt = VFRAME_SIGNAL_FMT_DOVI;
+	}
+
+	/* The auxiliary buffer the decoder hands over is padded to 32 bytes,
+	 * so the length reported here is an upper bound, not the metadata
+	 * length.  Only this path may accept the padding; the static metadata
+	 * path keeps the exact-length rule.
+	 */
+	dm_len = payload_len;
+	ret = dv_injection_walk_metadata(payload, payload_len,
+					 hdr10p_sei && !dv_sei ? 0 :
+					 DV_INJ_AUX_PAD_MAX, &dm_len);
+	if (ret) {
+		dv_inj_diag_producer(vf, vf->src_fmt.sei_size, payload,
+				     payload_len, 0, ret, 0, 0,
+				     hdr10p_sei && !dv_sei);
+		slot = &dv_inj_pool[vf->index & (DV_INJ_POOL_SIZE - 1)];
+		spin_lock_irqsave(&dv_inj_publish_lock, flags);
+		WRITE_ONCE(slot->valid, false);
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+		mutex_unlock(&dv_injection_lock);
+		return;
+	}
+
+	if (L5_adjust_mode >= 0)
+		modify_L5_data(vf, (u8 *)payload);
+	if (L1_adjust)
+		auto_set_L1((u8 *)payload);
+
+	slot = &dv_inj_pool[vf->index & (DV_INJ_POOL_SIZE - 1)];
+	dm_packet.num_pkts = 0;
+	ret = dv_injection_pack_bytes(dm_packet.byte_data,
+				      &dm_packet.num_pkts, payload, dm_len);
+	dv_inj_diag_producer(vf, vf->src_fmt.sei_size, payload, payload_len,
+			     dm_len, 0, ret, dm_packet.num_pkts,
+			     hdr10p_sei && !dv_sei);
+	if (!ret) {
+		dv_injection_expand_pixels(dm_packet.byte_data,
+					   dm_packet.num_pkts,
+					   dm_packet.pixel_data);
+		spin_lock_irqsave(&dv_inj_publish_lock, flags);
+		/* R2: only publish if this frame still belongs to the current
+		 * stream generation and the stream is still running.
+		 */
+		if (gen == READ_ONCE(dv_inj_generation) &&
+		    READ_ONCE(dv_inj_stream_running) &&
+		    READ_ONCE(dv_injection_enable)) {
+			memcpy(slot->pixel_data, dm_packet.pixel_data,
+			       sizeof(slot->pixel_data));
+			slot->num_pkts = dm_packet.num_pkts;
+			slot->generation = gen;
+			slot->mode_gen = READ_ONCE(dv_inj_mode_generation);
+			WRITE_ONCE(slot->valid, true);
+		}
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	}
+	mutex_unlock(&dv_injection_lock);
+}
