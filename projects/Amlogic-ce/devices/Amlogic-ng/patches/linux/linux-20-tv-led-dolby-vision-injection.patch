--- a/drivers/amlogic/media/video_sink/Kconfig
+++ b/drivers/amlogic/media/video_sink/Kconfig
@@ -29,4 +29,15 @@ config AMLOGIC_MEDIA_VIDEOCAPTURE
     help
 		Internal Video Capture driver
 
+config AMLOGIC_MEDIA_VIDEO_DV_INJECTION
+    bool "TV-led Dolby Vision metadata injection"
+    default y
+    depends on AMLOGIC_MEDIA_VIDEO
+    help
+		Embed the Dolby Vision Display Management metadata into the
+		top pixels of the OSD canvas and announce Dolby Vision with a
+		VSIF packet, so that the TV performs the reshaping itself.
+		This works on SoCs without a licensed Dolby Vision core.
+		The feature stays off until "dv_injection_enable" is set.
+
 endmenu
