+/*
+ * Feed the DM metadata (raw bytes) from user space.
+ */
+int dv_injection_set_metadata(const u8 *data, u32 size)
+{
+	int ret = dv_injection_validate_metadata(data, size);
+
+	if (ret)
+		return ret;
+	mutex_lock(&dv_injection_lock);
+	ret = dv_injection_form_packets(data, size);
+	if (!ret) {
+		memcpy(dm_metadata, data, size);
+		dm_metadata_size = size;
+	}
+	mutex_unlock(&dv_injection_lock);
+	return ret;
+}
+
+static int dv_injection_param_set(const char *val,
+				   const struct kernel_param *kp)
+{
+	u8 parsed[DV_INJ_MAX_METADATA_SIZE];
+	int size, ret;
+
+	if (!val || strlen(val) >= sizeof(dv_metadata))
+		return -EINVAL;
+	mutex_lock(&dv_injection_lock);
+	size = dv_injection_parse_metadata(val, parsed);
+	if (size < 0) {
+		mutex_unlock(&dv_injection_lock);
+		return size;
+	}
+	ret = dv_injection_pack_bytes(dm_packet.byte_data,
+				      &dm_packet.num_pkts, parsed, size);
+	if (!ret) {
+		unsigned long flags;
+
+		/* R4: expand into private scratch first - the old version wrote
+		 * straight into the published slot, so the display side could copy
+		 * a half new, half old buffer. */
+		dv_injection_expand_pixels(dm_packet.byte_data,
+					   dm_packet.num_pkts,
+					   dm_packet.pixel_data);
+		spin_lock_irqsave(&dv_inj_publish_lock, flags);
+		memcpy(dv_inj_static_slot.pixel_data, dm_packet.pixel_data,
+		       sizeof(dv_inj_static_slot.pixel_data));
+		dv_inj_static_slot.num_pkts = dm_packet.num_pkts;
+		dv_inj_static_slot.generation = READ_ONCE(dv_inj_generation);
+		dv_inj_static_slot.mode_gen = READ_ONCE(dv_inj_mode_generation);
+		WRITE_ONCE(dv_inj_static_slot.valid, true);
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+		strcpy(dv_metadata, val);
+		memcpy(dm_metadata, parsed, size);
+		dm_metadata_size = size;
+	}
+	mutex_unlock(&dv_injection_lock);
+	return ret;
+}
+
+static int dv_injection_param_get(char *buffer,
+				   const struct kernel_param *kp)
+{
+	char *buf = (char *)kp->arg;
+
+	if (!buf)
+		return 0;
+	return scnprintf(buffer, PAGE_SIZE, "%s", buf);
+}
+
+static const struct kernel_param_ops dv_metadata_ops = {
+	.set = dv_injection_param_set,
+	.get = dv_injection_param_get,
+};
+
+module_param_cb(dv_metadata, &dv_metadata_ops, &dv_metadata, 0644);
+MODULE_PARM_DESC(dv_metadata,
+		 "\n Dolby Vision DM metadata as hex string\n");
+
+static const char *dv_inj_diag_state_name(int state)
+{
+	switch (state) {
+	case DV_INJ_IDLE:
+		return "IDLE";
+	case DV_INJ_PREPARING:
+		return "PREPARING";
+	case DV_INJ_READY:
+		return "READY";
+	case DV_INJ_CLOSING:
+		return "CLOSING";
+	}
+	return "?";
+}
+
+static const char *dv_inj_diag_reason_name(u32 reason)
+{
+	switch (reason) {
+	case DV_INJ_DIAG_OK:
+		return "committed";
+	case DV_INJ_DIAG_NO_ENABLE:
+		return "no-enable";
+	case DV_INJ_DIAG_NO_STREAM:
+		return "no-stream";
+	case DV_INJ_DIAG_NO_SINK:
+		return "no-sink";
+	case DV_INJ_DIAG_STALE_SLOT:
+		return "stale-slot";
+	case DV_INJ_DIAG_STOPPED:
+		return "stopped";
+	case DV_INJ_DIAG_COPY_FAILED:
+		return "copy-failed";
+	case DV_INJ_DIAG_COMMIT_STOPPED:
+		return "stopped-late";
+	case DV_INJ_DIAG_VSIF_FAILED:
+		return "vsif-failed";
+	}
+	return "?";
+}
+
+/*
+ * The bytes that actually sit in the canvas, read back from the mapped buffer in
+ * process context.  The expected pixel_data is never printed here: the point of
+ * the readback is to show what the display path really left in memory.
+ */
+static void dv_inj_diag_canvas_line(struct seq_file *m, u32 page)
+{
+	u8 buf[64];
+	u8 __iomem *base;
+	unsigned long flags;
+	u32 page_bytes;
+	u32 i;
+	bool ok = false;
+
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	base = READ_ONCE(dv_inj_rt.base);
+	page_bytes = READ_ONCE(dv_inj_rt.page_bytes);
+	if (READ_ONCE(dv_inj_rt.ready) && base && page < READ_ONCE(dv_inj_rt.pages) &&
+	    page_bytes >= sizeof(buf)) {
+		memcpy_fromio(buf, base + page * page_bytes, sizeof(buf));
+		ok = true;
+	}
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	if (!ok) {
+		seq_printf(m, "canvas page%u: not readable\n", page);
+		return;
+	}
+	seq_printf(m, "canvas page%u[0..%u] crc=%08x ", page,
+		   (unsigned)(sizeof(buf) - 1),
+		   dv_injection_crc32(buf, (u32)sizeof(buf)));
+	for (i = 0; i < (u32)sizeof(buf); i++)
+		seq_printf(m, "%02x", buf[i]);
+	seq_putc(m, '\n');
+}
+
+static int dv_inj_diag_show(struct seq_file *m, void *unused)
+{
+	struct dv_inj_diag_rec rec;
+	unsigned long flags;
+	unsigned long torn;
+	u32 total;
+	u32 count;
+	u32 first;
+	u32 idx;
+	u32 i;
+	u32 vic = 0, cs = 0, cd = 0, cr = 0, ready = 0;
+
+	seq_printf(m, "diag=%u frames_left=%d commits_left=%d frames_budget=%u commits_budget=%u\n",
+		   dv_injection_diag, atomic_read(&dv_inj_diag_frames_left),
+		   atomic_read(&dv_inj_diag_commits_left),
+		   dv_injection_diag_frames, dv_injection_diag_commits);
+	seq_printf(m, "state=%s enable=%d ready=%d accepting=%d transport=%d stream=%d busy=%d\n",
+		   dv_inj_diag_state_name(READ_ONCE(dv_inj_state)),
+		   READ_ONCE(dv_injection_enable) ? 1 : 0,
+		   READ_ONCE(dv_inj_ready) ? 1 : 0,
+		   READ_ONCE(dv_inj_accepting) ? 1 : 0,
+		   READ_ONCE(dv_inj_transport_ready) ? 1 : 0,
+		   READ_ONCE(dv_inj_stream_running) ? 1 : 0,
+		   READ_ONCE(dv_inj_render_busy));
+	torn = READ_ONCE(dv_injection_torn_frames);
+	seq_printf(m, "torn_frames=%lu session=%u pending=%d pending_clear=%d pending_restore=%d change_in_progress=%d\n",
+		   torn, READ_ONCE(dv_inj_session), READ_ONCE(dv_inj_pending) ? 1 : 0,
+		   READ_ONCE(dv_inj_pending_clear) ? 1 : 0,
+		   READ_ONCE(dv_inj_pending_restore) ? 1 : 0,
+		   READ_ONCE(dv_inj_change_in_progress) ? 1 : 0);
+	seq_printf(m, "gens buffer=%u mode=%u canvas_dirty=%d canvas_committed=%d\n",
+		   READ_ONCE(dv_inj_buffer_generation),
+		   READ_ONCE(dv_inj_mode_generation),
+		   READ_ONCE(dv_inj_canvas_dirty) ? 1 : 0,
+		   READ_ONCE(dv_inj_canvas_committed) ? 1 : 0);
+	/* No kernel address is printed: the mapping itself is what matters, and
+	 * the file is world-readable.
+	 */
+	seq_printf(m, "canvas resolved=%d pages=%u page_bytes=%u offset_px=%u bytes_per_pixel=%u repeat=%u snr=%u\n",
+		   (READ_ONCE(dv_inj_rt.ready) && READ_ONCE(dv_inj_rt.base)) ? 1 : 0,
+		   READ_ONCE(dv_inj_rt.pages), READ_ONCE(dv_inj_rt.page_bytes),
+		   READ_ONCE(osd_pixel_offset), READ_ONCE(bytes_per_pixel),
+		   READ_ONCE(packet_repeat), READ_ONCE(dv_inj_display_snapshot.num_pkts));
+
+	hdmitx_dv_injection_format(&vic, &cs, &cd, &cr, &ready);
+	seq_printf(m, "hdmi vic=%u cs=%u cd=%u cr=%u ready=%u\n",
+		   vic, cs, cd, cr, ready);
+	dv_inj_diag_canvas_line(m, 0);
+	dv_inj_diag_canvas_line(m, 1);
+
+	spin_lock_irqsave(&dv_inj_diag_lock, flags);
+	total = dv_inj_diag_seq;
+	spin_unlock_irqrestore(&dv_inj_diag_lock, flags);
+	count = total < DV_INJ_DIAG_RECORDS ? total : DV_INJ_DIAG_RECORDS;
+	first = (total - count) % DV_INJ_DIAG_RECORDS;
+
+	seq_puts(m, "seq kind ms frame slot gen mgen v0 v1 v2 v3 crc epb epb_first flags prefix hex\n");
+	for (i = 0; i < count; i++) {
+		u32 j;
+
+		idx = (first + i) % DV_INJ_DIAG_RECORDS;
+		spin_lock_irqsave(&dv_inj_diag_lock, flags);
+		rec = dv_inj_diag_ring[idx];
+		spin_unlock_irqrestore(&dv_inj_diag_lock, flags);
+
+		if (rec.kind == DV_INJ_DIAG_KIND_FRAME) {
+			seq_printf(m, "%u frame ms=%u idx=%u slot=%u gen=%u mgen=%u validate=0x%x pack=0x%x num_pkts=%u len=%u eff=%u pad=%u sei=%u crc=%08x epb=%u epb_first=%u flags=0x%x prefix=%02x%02x%02x ",
+				   rec.seq, rec.ms, rec.frame, rec.slot,
+				   rec.generation, rec.mode_gen, rec.v0, rec.v1,
+				   rec.num_pkts, rec.v2, rec.eff_len, rec.pad, rec.v3,
+				   rec.crc, rec.epb, rec.epb_first, rec.flags,
+				   rec.prefix[0], rec.prefix[1], rec.prefix[2]);
+		} else if (rec.kind == DV_INJ_DIAG_KIND_COMMIT) {
+			seq_printf(m, "%u commit ms=%u reason=%s slot=%u gen=%u mgen=%u code=0x%x num_pkts=%u pages=%u page_bytes=%u crc=%08x epb=%u epb_first=%u flags=0x%x prefix=- ",
+				   rec.seq, rec.ms, dv_inj_diag_reason_name(rec.v0),
+				   rec.slot, rec.generation, rec.mode_gen, rec.v0,
+				   rec.v1, rec.v2, rec.v3, rec.crc, rec.epb,
+				   rec.epb_first, rec.flags);
+		} else {
+			seq_printf(m, "%u format ms=%u tag=%u state=%u gen=%u vic=0x%x cs=%u cd=%u cr=%u crc=%08x epb=%u epb_first=%u flags=0x%x prefix=- ",
+				   rec.seq, rec.ms, rec.v0, rec.slot,
+				   rec.generation, rec.v1, rec.v2, rec.v3,
+				   rec.crc, rec.epb, rec.epb_first, rec.flags);
+		}
+		for (j = 0; j < rec.hex_len; j++)
+			seq_printf(m, "%02x", rec.hex[j]);
+		seq_putc(m, '\n');
+	}
+	return 0;
+}
+
+static int dv_inj_diag_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, dv_inj_diag_show, NULL);
+}
+
+static const struct file_operations dv_inj_diag_fops = {
+	.owner = THIS_MODULE,
+	.open = dv_inj_diag_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int dv_injection_diag_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (ret)
+		return ret;
+	if (dv_injection_diag) {
+		/* A fresh arm: the ring stays readable, the budgets restart. */
+		dv_inj_diag_start = jiffies;
+		atomic_set(&dv_inj_diag_frames_left, dv_injection_diag_frames);
+		atomic_set(&dv_inj_diag_commits_left, dv_injection_diag_commits);
+	}
+	return 0;
+}
+
+static int __init dv_injection_init(void)
+{
+	INIT_DELAYED_WORK(&dv_inj_watchdog, dv_inj_watchdog_fn);
+	dv_inj_generation = 1;
+	dv_inj_ready = true;
+	dv_inj_diag_start = jiffies;
+	if (dv_injection_diag) {
+		atomic_set(&dv_inj_diag_frames_left, dv_injection_diag_frames);
+		atomic_set(&dv_inj_diag_commits_left, dv_injection_diag_commits);
+	}
+	dv_inj_diag_proc = proc_create("dv_injection_trace", 0444, NULL,
+				       &dv_inj_diag_fops);
+	dv_injection_log(1, "dv injection: module loaded\n");
+	return 0;
+}
+
+static void __exit dv_injection_exit(void)
+{
+	if (dv_inj_diag_proc) {
+		remove_proc_entry("dv_injection_trace", NULL);
+		dv_inj_diag_proc = NULL;
+	}
+	cancel_delayed_work_sync(&dv_inj_watchdog);
+	mutex_lock(&dv_injection_lock);
+	dv_injection_deactivate();
+	mutex_unlock(&dv_injection_lock);
+	dv_injection_log(1, "dv injection: module unloaded\n");
+}
+
+module_init(dv_injection_init);
+module_exit(dv_injection_exit);
+
+MODULE_DESCRIPTION("Amlogic TV-led Dolby Vision metadata injection");
+MODULE_AUTHOR("N1-CoreELEC project");
+MODULE_LICENSE("GPL");
