+/*
+ * Author semantics: after a GUI/OSD ioctl the active-area handling stays off
+ * for osd_L5_timeout_ms so menu drawing is not mistaken for a new composition.
+ * N1's fbdev ioctl (osd_fb.c) calls this.
+ */
+void dv_injection_note_osd_activity(void)
+{
+	WRITE_ONCE(last_osd_ioctl_time, jiffies);
+	WRITE_ONCE(dv_inj_canvas_dirty, true);
+}
+EXPORT_SYMBOL(dv_injection_note_osd_activity);
