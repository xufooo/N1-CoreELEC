+#define HDR10P_SEI 0x02000000
+#define HDR10P_SEI_HEADER_SIZE 4
+#define HDR10P_SEI_TOTAL_HEADER_SIZE 10
+#define PREFIX_SEI_NUT 39
+#define SUFFIX_SEI_NUT 40
+#define SEI_ITU_T_T35 4
+
+static uint16_t search_sei_for_dynamic_metadata(uint8_t *sei_data, uint32_t sei_size, uint8_t **dv_sei_payload, uint8_t **hdr10p_sei_payload){
+
+	uint32_t i;
+    uint16_t payload_size = 0;
+	uint8_t *p;
+    uint32_t size = 0;
+	uint32_t type = 0;
+    *dv_sei_payload = NULL;
+    *hdr10p_sei_payload = NULL;
+
+    if (sei_data && sei_size) {
+		// dv_injection_log(2, "Have SEI data\n");
+		// dv_injection_log(2, "size: %d, data:\n", sei_size);
+		// for(i = 0; i < sei_size; i++){
+		// 	dv_injection_log_cont(2, "0x%02x, ", sei_data[i]);
+		// 	if (((i + 1) & 0xf) == 0){
+		// 		dv_injection_log_cont(2, "\n");
+		// 	}
+		// }
+		// dv_injection_log_cont(2, "\n");
+
+        u32 count = 0;
+        u32 offest = 0;
+
+        p = sei_data;
+        while (p < sei_data + sei_size - 8) {
+            size = *p++;
+            size = (size << 8) | *p++;
+            size = (size << 8) | *p++;
+            size = (size << 8) | *p++;
+            type = *p++;
+            type = (type << 8) | *p++;
+            type = (type << 8) | *p++;
+            type = (type << 8) | *p++;
+            offest += 8;
+            if (offest + size > sei_size) {
+                break;
+            }
+            if (type == DV_SEI && 
+                size >= DV_SEI_VDR_MIN_LENGTH &&
+                p[0] == DV_SEI_VDR_HEADER_BYTE_1 &&
+                p[1] == DV_SEI_VDR_HEADER_BYTE_2 &&
+                p[2] == DV_SEI_VDR_HEADER_BYTE_3)
+            {
+                *dv_sei_payload = &p[DV_SEI_VDR_HEADER_LENGTH];
+                payload_size = size - DV_SEI_VDR_HEADER_LENGTH;
+				if(dv_injection_log_level){
+					dv_injection_log(2, "Found DV data in sei\n");
+					dv_injection_log(3, "size: %d, data:\n", payload_size);
+					for(i = 0; i < payload_size; i++){
+						dv_injection_log_cont(2, "0x%02x, ", dv_sei_payload[i]);
+					}
+					dv_injection_log_cont(2, "\n");
+				}
+                break;
+            } 
+            else if (type == HDR10P_SEI && 
+                size > HDR10P_SEI_TOTAL_HEADER_SIZE && 
+                (((p[0] & 0x7E) >> 1) == PREFIX_SEI_NUT || ((p[0] & 0x7E) >> 1) == SUFFIX_SEI_NUT) &&
+                p[2] == SEI_ITU_T_T35 &&
+                p[3] <= size - 4 &&
+                p[4] == 0xB5 &&
+                p[5] == 0x00 &&
+                p[6] == 0x3C &&
+                p[7] == 0x00 &&
+                p[8] == 0x01 &&
+                p[9] == 0x04)
+            { 
+                dv_injection_log(2, "Found HDR10+ data in sei\n");
+                *hdr10p_sei_payload = &p[4];
+                payload_size = p[3];
+            }
+
+            count++;
+            offest += size;
+            p += size;
+        }
+    }
+
+    return payload_size;
+}
