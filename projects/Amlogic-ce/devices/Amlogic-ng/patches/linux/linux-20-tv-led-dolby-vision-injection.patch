+/*
+ * Producer side.  This runs whether or not the injection succeeds, so a play
+ * that locks up or fails validation still leaves the record that came in.
+ */
+static void dv_inj_diag_producer(const struct vframe_s *vf, u32 sei_size,
+				 const u8 *payload, u32 payload_len,
+				 u32 eff_len, int validate_rc, int pack_rc,
+				 u32 num_pkts, bool from_hdr10p)
+{
+	struct dv_inj_diag_rec rec;
+	u32 i;
+	u32 copy;
+
+	if (!READ_ONCE(dv_injection_diag))
+		return;
+	if (!dv_inj_diag_take(&dv_inj_diag_frames_left))
+		return;
+
+	dv_inj_diag_common(&rec, DV_INJ_DIAG_KIND_FRAME, vf ? vf->index : 0);
+	rec.slot = vf ? (vf->index & (DV_INJ_POOL_SIZE - 1)) : 0;
+	rec.v0 = (u32)validate_rc;
+	rec.v1 = pack_rc ? (u32)pack_rc : num_pkts;
+	rec.v2 = payload_len;
+	rec.v3 = sei_size;
+	rec.num_pkts = num_pkts;
+	rec.eff_len = eff_len;
+	rec.pad = eff_len && payload_len > eff_len ? payload_len - eff_len : 0;
+	if (from_hdr10p)
+		rec.flags |= DV_INJ_DIAG_F_HDR10P;
+	if (payload && payload_len) {
+		u32 span = eff_len && eff_len <= payload_len ?
+			eff_len : payload_len;
+
+		rec.crc = dv_injection_crc32(payload, span);
+		copy = span < 3 ? span : 3;
+		memcpy(rec.prefix, payload, copy);
+		copy = span < DV_INJ_DIAG_HEX ? span : DV_INJ_DIAG_HEX;
+		rec.hex_len = (u8)copy;
+		memcpy(rec.hex, payload, copy);
+		if (span > copy)
+			rec.flags |= DV_INJ_DIAG_F_TRUNC;
+		/* An emulation prevention byte shows up as 00 00 03; the first
+		 * offset is what decides whether the sink was handed a raw or a
+		 * de-escaped payload.
+		 */
+		for (i = 0; i + 2 < span; i++) {
+			if (payload[i] || payload[i + 1] || payload[i + 2] != 3)
+				continue;
+			if (!rec.epb)
+				rec.epb_first = i;
+			rec.epb++;
+		}
+		if (rec.epb)
+			rec.flags |= DV_INJ_DIAG_F_EPB;
+	}
+	dv_inj_diag_add(&rec);
+}
+
+/* Display side, interrupt context: a struct copy under a spinlock, no print. */
+static void dv_inj_diag_commit(int reason, const struct dv_inj_slot *slot)
+{
+	struct dv_inj_diag_rec rec;
+
+	if (!READ_ONCE(dv_injection_diag))
+		return;
+	if (!dv_inj_diag_take(&dv_inj_diag_commits_left))
+		return;
+
+	dv_inj_diag_common(&rec, DV_INJ_DIAG_KIND_COMMIT, 0);
+	rec.v0 = (u32)reason;
+	if (slot) {
+		rec.slot = (u32)(slot - dv_inj_pool);
+		rec.v1 = slot->num_pkts;
+		rec.generation = slot->generation;
+		rec.mode_gen = slot->mode_gen;
+	}
+	if (reason == DV_INJ_DIAG_OK) {
+		rec.v2 = READ_ONCE(dv_inj_rt.pages);
+		rec.v3 = READ_ONCE(dv_inj_rt.page_bytes);
+	}
+	dv_inj_diag_add(&rec);
+}
+
+/*
+ * Format snapshot: what the HDMI side believes it drives, taken from the
+ * driver's own state - no register is read or written here.
+ */
+static void dv_inj_diag_format(u32 tag)
+{
+	struct dv_inj_diag_rec rec;
+	u32 vic = 0, cs = 0, cd = 0, cr = 0, ready = 0;
+
+	if (!READ_ONCE(dv_injection_diag))
+		return;
+
+	hdmitx_dv_injection_format(&vic, &cs, &cd, &cr, &ready);
+	dv_inj_diag_common(&rec, DV_INJ_DIAG_KIND_FORMAT, 0);
+	rec.v0 = tag;
+	rec.v1 = vic;
+	rec.v2 = cs;
+	rec.v3 = cd;
+	rec.crc = cr;
+	rec.epb = (u16)ready;
+	rec.slot = READ_ONCE(dv_inj_state);
+	dv_inj_diag_add(&rec);
+}
+
+static enum hdr_dm_packet_type dv_injection_pkt_type(u8 cur, u8 num)
+{
+	if (cur == 0)
+		return (num == 1) ? DV_INJ_FIRST_AND_ONLY_PKT :
+			DV_INJ_FIRST_OF_MULTIPLE_PKT;
+	return ((cur + 1) != num) ? DV_INJ_CONTINUING_PKT :
+		DV_INJ_LAST_OF_MULTIPLE_PKT;
+}
+
+/*
+ * Split the DM metadata into Dolby Vision metadata packets and turn
+ * every bit into one picture pixel.
+ */
+static int dv_injection_pack_bytes(u8 byte_data[][DV_INJ_NUM_BYTES_PER_PACKET],
+				   u8 *out_num_pkts, const u8 *metadata, u32 size)
+{
+	u8 pkt_num;
+	u8 *cur_pkt;
+	u32 cur_pkt_len;
+	u32 last_pkt_len;
+	u32 bytes_written = 0;
+	u32 pkt_offset;
+	u32 num_pkts = 1;
+	u32 crc;
+	u8 *crc_ptr = (u8 *)&crc;
+	enum hdr_dm_packet_type pkt_type;
+
+	if (!metadata || !size || size > DV_INJ_MAX_METADATA_SIZE)
+		return -EINVAL;
+
+	last_pkt_len = size;
+	if (last_pkt_len > 119) {
+		last_pkt_len -= 119;
+		while (last_pkt_len > 121) {
+			last_pkt_len -= 121;
+			num_pkts++;
+		}
+		if (last_pkt_len > 0)
+			num_pkts++;
+	}
+	if (num_pkts > DV_INJ_MAX_NUM_HDR_DM_PACKETS)
+		return -EINVAL;
+
+	memset(byte_data, 0,
+	       num_pkts * DV_INJ_NUM_BYTES_PER_PACKET);
+
+	for (pkt_num = 0; pkt_num < num_pkts; pkt_num++) {
+		cur_pkt = byte_data[pkt_num];
+		pkt_type = dv_injection_pkt_type(pkt_num, (u8)num_pkts);
+
+		if (pkt_type == DV_INJ_FIRST_AND_ONLY_PKT ||
+		    pkt_type == DV_INJ_FIRST_OF_MULTIPLE_PKT) {
+			cur_pkt[0] = (pkt_type == DV_INJ_FIRST_AND_ONLY_PKT) ?
+				0 : 0x40;
+			cur_pkt[1] = metadata[0];
+			cur_pkt[2] = 0;
+			cur_pkt[3] = (u8)(size >> 8);
+			cur_pkt[4] = (u8)(size & 0xFF);
+			cur_pkt_len = (pkt_type == DV_INJ_FIRST_AND_ONLY_PKT) ?
+				last_pkt_len : 119;
+			pkt_offset = 5;
+		} else {
+			cur_pkt[0] = (pkt_type == DV_INJ_LAST_OF_MULTIPLE_PKT) ?
+				0xC0 : 0x80;
+			cur_pkt[1] = metadata[0];
+			cur_pkt[2] = 0;
+			cur_pkt_len = (pkt_type == DV_INJ_LAST_OF_MULTIPLE_PKT) ?
+				last_pkt_len : 121;
+			pkt_offset = 3;
+		}
+
+		memcpy(&cur_pkt[pkt_offset], &metadata[bytes_written],
+		       cur_pkt_len);
+		bytes_written += cur_pkt_len;
+
+		if (bytes_written >= size)
+			memset(&cur_pkt[pkt_offset + cur_pkt_len], 0,
+			       DV_INJ_NUM_BYTES_PER_PACKET - 4 -
+			       pkt_offset - cur_pkt_len);
+
+		crc = dv_injection_crc32(cur_pkt, DV_INJ_NUM_BYTES_PER_PACKET - 4);
+		cur_pkt[DV_INJ_CRC_OFFSET] = crc_ptr[3];
+		cur_pkt[DV_INJ_CRC_OFFSET + 1] = crc_ptr[2];
+		cur_pkt[DV_INJ_CRC_OFFSET + 2] = crc_ptr[1];
+		cur_pkt[DV_INJ_CRC_OFFSET + 3] = crc_ptr[0];
+	}
+
+	*out_num_pkts = (u8)num_pkts;
+	return 0;
+}
+
+/* bit -> pixel, into the slot's prepared pixel buffer */
+static void dv_injection_expand_pixels(const u8 byte_data[][DV_INJ_NUM_BYTES_PER_PACKET],
+				       u8 num_pkts,
+				       u32 pixel_data[][DV_INJ_PIXELS_PER_PKT])
+{
+	u8 pkt_num, byte_num, bit_num, injected_byte;
+
+	for (pkt_num = 0; pkt_num < num_pkts; pkt_num++) {
+		for (byte_num = 0; byte_num < DV_INJ_NUM_BYTES_PER_PACKET;
+		     byte_num++) {
+			injected_byte = byte_data[pkt_num][byte_num];
+			for (bit_num = 0; bit_num < DV_INJ_BITS_PER_BYTE;
+			     bit_num++) {
+				pixel_data[pkt_num]
+					[byte_num * DV_INJ_BITS_PER_BYTE +
+					 bit_num] =
+					((injected_byte >> (7 - bit_num)) & 1) ?
+					odd_pattern : even_pattern;
+			}
+		}
+	}
+}
+
+static int dv_injection_form_packets(const u8 *metadata, u32 size)
+{
+	return dv_injection_pack_bytes(dm_packet.byte_data,
+				       &dm_packet.num_pkts, metadata, size);
+}
+
+/* Locate the Dolby Vision payload inside the decoder SEI buffer.  The
+ * reference implementation wraps the serialised DM data as
+ * 0x7C 0x01 0xFF inside a type 0x01000000 (DV) SEI block.
+ */
+static int dv_injection_find_dv_sei(const void *sei_data, u32 sei_size,
+				    const u8 **payload, u32 *payload_len)
+{
+	const u8 *p = (const u8 *)sei_data;
+	u32 offset = 0;
+
+	if (!p || !sei_size)
+		return -EINVAL;
+
+	while (offset + 8 <= sei_size) {
+		u32 size = ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+			   ((u32)p[2] << 8) | p[3];
+		u32 type = ((u32)p[4] << 24) | ((u32)p[5] << 16) |
+			   ((u32)p[6] << 8) | p[7];
+
+		p += 8;
+		offset += 8;
+		if (offset + size > sei_size)
+			break;
+		if (type == DV_SEI_TYPE &&
+		    size >= DV_SEI_VDR_HEADER_LENGTH + DV_SEI_VDR_MIN_BODY &&
+		    p[0] == 0x7C && p[1] == 0x01 && p[2] == 0xFF) {
+			*payload = p + DV_SEI_VDR_HEADER_LENGTH;
+			*payload_len = size - DV_SEI_VDR_HEADER_LENGTH;
+			return 0;
+		}
+		p += size;
+		offset += size;
+	}
+	return -ENOENT;
+}
+
+/*
+ * Write the packetised metadata into the top left corner of the OSD
+ * canvas.  This is the "top pixel" embedding the TV expects for
+ * TV-led Dolby Vision.
+ */
+/* Pure checked arithmetic, also exercised by the host regression test. */
+static int dv_injection_canvas_layout(u32 stride, u32 xres, u32 yres,
+				     u32 yvirtual, u64 allocation, u32 num_pkts,
+				     u32 repeat, u64 *page_bytes, u32 *pages)
+{
+	u64 metadata_bytes, total;
+
+	if (!stride || !xres || !yres || !yvirtual || (stride & 3) ||
+	    (u64)xres * 4 > stride || yvirtual % yres ||
+	    !num_pkts || num_pkts > DV_INJ_MAX_NUM_HDR_DM_PACKETS ||
+	    repeat < 1 || repeat > DV_INJ_NUM_HDR_DM_PACKET_REPEATS)
+		return -EINVAL;
+	*pages = yvirtual / yres;
+	if (*pages < 1 || *pages > 3)
+		return -EINVAL;
+	*page_bytes = (u64)stride * yres;
+	total = (u64)stride * yvirtual;
+	metadata_bytes = ((u64)(num_pkts - 1) *
+		DV_INJ_NUM_HDR_DM_PACKET_REPEATS + repeat) *
+		DV_INJ_PIXELS_PER_PKT * 4;
+	if (total > allocation || metadata_bytes > *page_bytes ||
+	    *page_bytes / 4 > 0xffffffffULL)
+		return -EINVAL;
+	return 0;
+}
+
+/* Process context: resolve and validate the OSD canvas once.  The display
+ * path runs in the vsync interrupt and must not take console_lock/fb locks.
+ */
+struct dv_inj_candidate {
+	u8 __iomem *base;
+	u64 page_bytes;
+	u32 pages;
+	u32 gen;
+};
+
+/* Build a candidate from the OSD target that is actually in effect.  Nothing is
+ * published here, so this is safe to call while injection is still disabled.
+ */
+static int dv_injection_build_candidate(const struct vinfo_s *vinfo,
+					struct dv_inj_candidate *cand)
+{
+	struct canvas_s cs;
+	struct fb_info *info;
+	u64 page_bytes;
+	u32 pages;
+	u32 canvas_index = READ_ONCE(osd_canvas);
+	int ret = -EINVAL;
+
+	memset(cand, 0, sizeof(*cand));
+	if (!vinfo)
+		return -EINVAL;
+	if (READ_ONCE(bytes_per_pixel) != 4 || canvas_index > 255)
+		return -EINVAL;
+
+	/* Capture the generation before inspecting the target, so a change that
+	 * happens during the inspection is detected instead of masked.
+	 */
+	cand->gen = READ_ONCE(dv_inj_buffer_generation);
+
+	console_lock();
+	info = registered_fb[0];
+	if (!info || !lock_fb_info(info))
+		goto out_console;
+	memset(&cs, 0, sizeof(cs));
+	canvas_read(canvas_index, &cs);
+	if (!info->screen_base || !info->fix.smem_len ||
+	    info->var.bits_per_pixel != 32 ||
+	    cs.addr != info->fix.smem_start ||
+	    cs.width != info->fix.line_length ||
+	    cs.height < info->var.yres_virtual ||
+	    info->var.xres != vinfo->width || info->var.yres != vinfo->height)
+		goto out_fb;
+	ret = dv_injection_canvas_layout(info->fix.line_length,
+		info->var.xres, info->var.yres, info->var.yres_virtual,
+		info->fix.smem_len, DV_INJ_MAX_NUM_HDR_DM_PACKETS,
+		READ_ONCE(packet_repeat), &page_bytes, &pages);
+	if (ret)
+		goto out_fb;
+	cand->base = (u8 __iomem *)info->screen_base;
+	cand->page_bytes = page_bytes;
+	cand->pages = pages;
+	ret = 0;
+out_fb:
+	unlock_fb_info(info);
+out_console:
+	console_unlock();
+	return ret;
+}
+
+/* Publish a candidate and mark the display ready - only if the target has not
+ * changed since it was built and a preparation request is still outstanding.
+ */
+static int dv_injection_publish_candidate(const struct dv_inj_candidate *cand)
+{
+	unsigned long flags;
+	int ret = -EAGAIN;
+
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	/* A canvas whose before_change has not completed yet is not a valid
+	 * target: binding it would publish an address the driver is about to
+	 * replace.  Cold start has no change in progress, so it still passes.
+	 */
+	if (!READ_ONCE(dv_inj_change_in_progress) &&
+	    cand->gen == READ_ONCE(dv_inj_buffer_generation) &&
+	    (READ_ONCE(dv_inj_transport_requested) ||
+	     READ_ONCE(dv_injection_enable))) {
+		WRITE_ONCE(osd_pixel_offset, (unsigned int)(cand->page_bytes / 4));
+		WRITE_ONCE(dv_inj_rt.base, cand->base);
+		WRITE_ONCE(dv_inj_rt.page_bytes, (u32)cand->page_bytes);
+		WRITE_ONCE(dv_inj_rt.pages, cand->pages);
+		WRITE_ONCE(dv_inj_rt.ready, true);
+		ret = 0;
+	} else {
+		WRITE_ONCE(dv_inj_rt.ready, false);
+	}
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	return ret;
+}
+
+static int dv_injection_resolve_canvas(const struct vinfo_s *vinfo)
+{
+	struct dv_inj_candidate cand;
+
+	if (dv_injection_build_candidate(vinfo, &cand))
+		return -EINVAL;
+	return dv_injection_publish_candidate(&cand);
+}
+
+/* Interrupt context: copy the prepared pixels of one slot, nothing else. */
+static int dv_injection_copy_pixels(const struct dv_inj_slot *slot)
+{
+	u8 __iomem *base = READ_ONCE(dv_inj_rt.base);
+	u32 page_bytes = READ_ONCE(dv_inj_rt.page_bytes);
+	u32 pages = READ_ONCE(dv_inj_rt.pages);
+	u32 repeats = READ_ONCE(packet_repeat);
+	u32 page, pkt, repeat;
+
+	if (!READ_ONCE(dv_inj_rt.ready) || !base || !slot->num_pkts ||
+	    repeats < 1 || repeats > DV_INJ_NUM_HDR_DM_PACKET_REPEATS)
+		return -EINVAL;
+
+	for (page = 0; page < pages; page++) {
+		for (pkt = 0; pkt < slot->num_pkts; pkt++) {
+			for (repeat = 0; repeat < repeats; repeat++) {
+				u64 offset = page * page_bytes +
+					(pkt * DV_INJ_NUM_HDR_DM_PACKET_REPEATS +
+					 repeat) * DV_INJ_PIXELS_PER_PKT * 4;
+
+				memcpy_toio(base + offset,
+					    slot->pixel_data[pkt],
+					    DV_INJ_PIXELS_PER_PKT * 4);
+			}
+		}
+	}
+	/* Order mapped buffer writes before announcing the DV signal. */
+	wmb();
+	return 0;
+}
