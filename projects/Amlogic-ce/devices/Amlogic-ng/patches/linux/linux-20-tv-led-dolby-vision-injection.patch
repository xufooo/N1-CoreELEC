+
+/*
+ * The 4.9 HDMI driver maps RGB_8BIT to the native picture path (YUV444 with
+ * the colour depth the EDID asks for).  The injection must not change that:
+ * the picture path is shared with the vout side, and reprogramming it
+ * desynchronises the two and blanks the TV.  The metadata rides on the
+ * picture as it is (metadata bits in the OSD canvas, VSIF per frame), just
+ * like the reference implementation does.
+ */
+bool dv_injection_block_hdr10(void)
+{
+	bool has_metadata = READ_ONCE(dv_injection_active);
+
+	return READ_ONCE(dv_injection_enable) && should_block_vsif(has_metadata);
+}
+EXPORT_SYMBOL(dv_injection_block_hdr10);
