+static void dv_inj_diag_add(const struct dv_inj_diag_rec *rec)
+{
+	struct dv_inj_diag_rec *dst;
+	unsigned long flags;
+
+	spin_lock_irqsave(&dv_inj_diag_lock, flags);
+	dst = &dv_inj_diag_ring[dv_inj_diag_head];
+	*dst = *rec;
+	dst->seq = dv_inj_diag_seq + 1;
+	dv_inj_diag_seq = dv_inj_diag_seq + 1;
+	dv_inj_diag_head = (dv_inj_diag_head + 1) % DV_INJ_DIAG_RECORDS;
+	spin_unlock_irqrestore(&dv_inj_diag_lock, flags);
+}
