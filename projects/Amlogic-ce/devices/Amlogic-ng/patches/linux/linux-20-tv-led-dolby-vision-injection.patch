+/* HDR10+ SEI lives in type 0x02000000 blocks carrying an ITU-T T.35 payload
+ * (0xB5 00 3C 00 01 04).  Only used when generating DV metadata for HDR10+
+ * sources with no RPU of their own.
+ */
+#define HDR10P_SEI_TYPE 0x02000000
+static int dv_injection_find_hdr10p_sei(const void *sei_data, u32 sei_size,
+					const u8 **payload, u32 *payload_len)
+{
+	const u8 *p = (const u8 *)sei_data;
+	u32 offset = 0;
+
+	if (!p || !sei_size)
+		return -EINVAL;
+	while (offset + 8 <= sei_size) {
+		u32 size = ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+			   ((u32)p[2] << 8) | p[3];
+		u32 type = ((u32)p[4] << 24) | ((u32)p[5] << 16) |
+			   ((u32)p[6] << 8) | p[7];
+		p += 8;
+		offset += 8;
+		if (offset + size > sei_size)
+			break;
+		if (type == HDR10P_SEI_TYPE && size > 10 &&
+		    p[0] == 0xB5 && p[2] == 0x3C && p[3] == 0x00 &&
+		    p[4] == 0x01 && p[5] == 0x04) {
+			*payload = p;
+			*payload_len = size;
+			return 0;
+		}
+		p += size;
+		offset += size;
+	}
+	return -ENOENT;
+}
