+extern bool hdmitx_vsif_tx_ready(void);
+extern int hdmitx_set_vsif_pkt_checked(enum eotf_type type,
+				      enum mode_type tunnel_mode,
+				      struct dv_vsif_para *data, bool signal_sdr);
+extern int hdmitx_prepare_output_for_injection(void);
+extern bool hdmitx_transport_is_live(void);
+extern void hdmitx_dv_injection_format(u32 *vic, u32 *cs, u32 *cd,
+				       u32 *cr, u32 *ready);
+extern void hdmitx_set_dv_injection_transport(bool enable);
+extern void hdmitx_set_dv_injection_policy(int policy);
