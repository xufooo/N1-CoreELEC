+/*
+ * While injection is active the Dolby VSIF has to stay on the wire.  A
+ * profile 7 stream carries an HDR10 base layer, and the video path keeps
+ * re-sending that DRM packet roughly every 100 ms, which wins the race
+ * against our VSIF and leaves the sink in HDR10 (measured: the HDMI
+ * status flipped between HDR10 and DolbyVision-Std once per second).
+ */
+
+/* ---- other-source arbitration, ported from the reference ---- */
+static bool force_block_other_vsif_for_DV;
+module_param(force_block_other_vsif_for_DV, bool, 0664);
+MODULE_PARM_DESC(force_block_other_vsif_for_DV, "\n always block other VSIF sources\n");
+
+static bool auto_block_other_vsif_for_DV = true;
+module_param(auto_block_other_vsif_for_DV, bool, 0664);
+MODULE_PARM_DESC(auto_block_other_vsif_for_DV, "\n block other VSIF sources while DV metadata is present\n");
+
+static bool should_block_vsif(bool dv_metadata)
+{
+	return force_block_other_vsif_for_DV ||
+	       (auto_block_other_vsif_for_DV && dv_metadata);
+}
