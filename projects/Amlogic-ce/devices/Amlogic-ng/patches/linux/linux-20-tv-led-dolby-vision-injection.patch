+/*
+ * Dolby Vision metadata injection.
+ *
+ * The metadata travels in the least significant bit of the transmitted
+ * samples and the tunnel mode the TV is told about (DV_RGB_444_8BIT) only
+ * works when the samples on the wire really are RGB.  The video path of this
+ * SoC can only deliver YUV444, but the HDMI block converts YUV to RGB on its
+ * own, so the injection asks for an RGB 8 bit output format.  Only the HDMI
+ * output changes: the video path and the mode timing stay untouched.
+ */
+static bool hdmitx_dv_injection_rgb_transport;
+static enum hdmi_color_space hdmitx_prog_cs = COLORSPACE_YUV444;
+static enum hdmi_color_depth hdmitx_prog_cd = COLORDEPTH_24B;
+
+/*
+ * Transport policy of the metadata injection.
+ *
+ * The video path of this SoC delivers YUV444 samples only, so the Dolby
+ * Vision tunnel has to be established by the transmitter.  Which tunnel a
+ * television accepts is a property of that television, so the policy is a
+ * runtime choice:
+ *
+ *  0 - native: the output keeps the format the mode set programmed
+ *  1 - RGB 8 bit: RGB444 with 24 bit depth, the tunnel the television
+ *      advertises as DV_RGB_444_8BIT
+ *  2 - RGB with the depth the mode set asked for: the colour space
+ *      converter then uses the offsets of that depth instead of the eight
+ *      bit ones, which is what the samples on the wire really are
+ *  3 - YUV 4:2:2 with that depth: the 12 bit Dolby Vision tunnel, no
+ *      colour conversion at all
+ *  5 - YUV 4:4:4 with that depth: the colour space the vendor tree
+ *      programs for the RGB 8 bit Dolby Vision tunnel, but with the
+ *      width the samples really have, so nothing has to be truncated
+ */
+#define DV_INJ_TP_NATIVE		0
+#define DV_INJ_TP_RGB_8BIT		1
+#define DV_INJ_TP_RGB_NATIVE_CD		2
+#define DV_INJ_TP_YUV422		3
+#define DV_INJ_TP_YUV444_8BIT	4
+#define DV_INJ_TP_YUV444_NATIVE_CD	5
+
+static int hdmitx_dv_injection_policy = DV_INJ_TP_NATIVE;
+/* Announce the colour space that is really on the wire, instead of the
+ * one the tunnel mode would suggest.  Off means: follow the vendor rule.
+ */
+static bool hdmitx_dv_injection_avi_yuv444 = true;
+
+void hdmitx_set_dv_injection_avi_yuv444(bool enable)
+{
+	hdmitx_dv_injection_avi_yuv444 = enable;
+}
+EXPORT_SYMBOL(hdmitx_set_dv_injection_avi_yuv444);
+
+void hdmitx_set_dv_injection_transport(bool enable)
+{
+	hdmitx_dv_injection_rgb_transport = enable;
+}
+EXPORT_SYMBOL(hdmitx_set_dv_injection_transport);
+
+void hdmitx_set_dv_injection_policy(int policy)
+{
+	if (policy < DV_INJ_TP_NATIVE ||
+	    policy > DV_INJ_TP_YUV444_NATIVE_CD)
+		return;
+	hdmitx_dv_injection_policy = policy;
+}
+EXPORT_SYMBOL(hdmitx_set_dv_injection_policy);
+
+int hdmitx_dv_injection_policy_get(void)
+{
+	return hdmitx_dv_injection_policy;
+}
+EXPORT_SYMBOL(hdmitx_dv_injection_policy_get);
+
+/* True when the HDMI output really carries RGB 8 bit samples. */
+bool hdmitx_transport_is_rgb444_8bit(void)
+{
+	return hdmitx_prog_cs == COLORSPACE_RGB444 &&
+		hdmitx_prog_cd == COLORDEPTH_24B;
+}
+EXPORT_SYMBOL(hdmitx_transport_is_rgb444_8bit);
+
+/* True when the programmed output is the one the policy asks for. */
+bool hdmitx_transport_matches_policy(void)
+{
+	if (!hdmitx_dv_injection_rgb_transport)
+		return false;
+	switch (hdmitx_dv_injection_policy) {
+	case DV_INJ_TP_RGB_8BIT:
+		return hdmitx_prog_cs == COLORSPACE_RGB444 &&
+			hdmitx_prog_cd == COLORDEPTH_24B;
+	case DV_INJ_TP_RGB_NATIVE_CD:
+		return hdmitx_prog_cs == COLORSPACE_RGB444;
+	case DV_INJ_TP_YUV422:
+		return hdmitx_prog_cs == COLORSPACE_YUV422;
+	case DV_INJ_TP_YUV444_8BIT:
+		return hdmitx_prog_cs == COLORSPACE_YUV444 &&
+			hdmitx_prog_cd == COLORDEPTH_24B;
+	case DV_INJ_TP_YUV444_NATIVE_CD:
+		return hdmitx_prog_cs == COLORSPACE_YUV444;
+	default:
+		return true;
+	}
+}
+EXPORT_SYMBOL(hdmitx_transport_matches_policy);
