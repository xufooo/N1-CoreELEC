+/*
+ * The metadata injection rides on the picture that is already on screen: the
+ * VSIF is handed over per frame and the metadata bits are written into the
+ * OSD canvas.  The picture path itself is never reprogrammed.
+ *
+ * Re-running the mode selection (set_disp_mode_auto()) desynchronises the
+ * vout side - the framebuffer keeps its own timing and the HDMI side picks a
+ * different VIC - and the TV then shows "no signal".
+ *
+ * What the injection does need is the RGB 8 bit transport: the tunnel mode
+ * the TV is told about (DV_RGB_444_8BIT) only works when the samples on the
+ * wire are RGB, and only the HDMI block can turn the YUV444 samples of the
+ * video path into RGB.  So the video format of the HDMI output is
+ * reprogrammed - and only that: no VIC, no PLL, no encoder.
+ */
+/* The mode set runs under setclk_mutex, so the injection must not reprogram
+ * the output format while a mode change is in flight.
+ */
+void hdmitx_reconfigure_video_format(void)
+{
+	mutex_lock(&setclk_mutex);
+	hdmitx_reconfigure_video_format_hw();
+	mutex_unlock(&setclk_mutex);
+}
+EXPORT_SYMBOL(hdmitx_reconfigure_video_format);
+
+int hdmitx_prepare_output_for_injection(void)
+{
+	if (!hdmitx_vsif_tx_ready())
