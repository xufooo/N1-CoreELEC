+static void dv_inj_diag_common(struct dv_inj_diag_rec *rec, u32 kind, u32 frame)
+{
+	memset(rec, 0, sizeof(*rec));
+	rec->kind = kind;
+	rec->ms = jiffies_to_msecs(jiffies - dv_inj_diag_start);
+	rec->frame = frame;
+	rec->generation = READ_ONCE(dv_inj_generation);
+	rec->mode_gen = READ_ONCE(dv_inj_mode_generation);
+}
