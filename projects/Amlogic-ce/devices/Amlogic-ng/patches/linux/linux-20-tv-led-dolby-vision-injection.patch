+/*
+ * Put the output back into the format the mode set programmed.
+ *
+ * Unlike the preparation this must not wait for the VSIF path: a sink that
+ * went away has to give the output back as well.  It can still fail while
+ * the transmitter is owned by a BIST pattern, and the caller has to keep its
+ * transaction alive until the output really carries the native format again -
+ * otherwise the picture would keep the colour space of the injection.
+ */
+int hdmitx_restore_output_format(void)
+{
+	struct hdmitx_dev *hdev = &hdmitx_device;
+
+	if (hdev->bist_lock)
+		return -EAGAIN;
+	hdmitx_reconfigure_video_format();
+	return 0;
+}
+EXPORT_SYMBOL(hdmitx_restore_output_format);
