diff --git a/include/linux/amlogic/media/video_sink/dv_injection.h b/include/linux/amlogic/media/video_sink/dv_injection.h
new file mode 100644
index 0000000000..3333333333
--- /dev/null
+++ b/include/linux/amlogic/media/video_sink/dv_injection.h
@@ -0,0 +1,24 @@
+/*
+ * Amlogic TV-led Dolby Vision metadata injection
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef _DV_INJECTION_H
+#define _DV_INJECTION_H
+
+#include <linux/types.h>
+
+struct vframe_s;
+
+/* write the Dolby Vision DM metadata into the OSD canvas and keep the
+ * Dolby VSIF alive; called for every frame by the video sink
+ */
+void dv_injection_process_frame(struct vframe_s *vf);
+bool dv_injection_render_frame(struct vframe_s *vf);
+bool dv_injection_block_hdr10(void);
+
+/* hand over the raw DM metadata bytes (user space / Kodi) */
+int dv_injection_set_metadata(const u8 *data, u32 size);
+
+#endif /* _DV_INJECTION_H */
