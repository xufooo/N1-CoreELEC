+		if (hdmitx_prog_cs == COLORSPACE_RGB444)
+			return COLORSPACE_RGB444;
+		if (hdmitx_prog_cs == COLORSPACE_YUV422)
+			return COLORSPACE_YUV422;
+	}
+	return cs;
+}
+EXPORT_SYMBOL(hdmitx_avi_color_space);
+
+enum hdmi_color_space hdmitx_dvi_avi_colorspace(enum mode_type tunnel_mode)
+{
+	/* The vendor path can only announce RGB444 (the RGB 8 bit tunnel)
+	 * or YUV422 (every other tunnel).  When the injection drives a
+	 * YUV444 output the announcement has to follow the samples on the
+	 * wire, otherwise the sink reads YUV data as RGB.
+	 */
+	if (hdmitx_dv_injection_rgb_transport &&
+	    hdmitx_dv_injection_avi_yuv444 &&
+	    (hdmitx_dv_injection_policy == DV_INJ_TP_YUV444_8BIT ||
+	     hdmitx_dv_injection_policy == DV_INJ_TP_YUV444_NATIVE_CD))
+		return COLORSPACE_YUV444;
+	if (tunnel_mode == RGB_8BIT)
+		return COLORSPACE_RGB444;
+	return COLORSPACE_YUV422;
+}
+EXPORT_SYMBOL(hdmitx_dvi_avi_colorspace);
+
+/* Format that is really programmed, for the diagnostic trace. */
+void hdmitx_transport_programmed_cs_cd(u32 *cs, u32 *cd)
+{
+	if (cs)
+		*cs = (u32)hdmitx_prog_cs;
+	if (cd)
+		*cd = (u32)hdmitx_prog_cd;
+}
+EXPORT_SYMBOL(hdmitx_transport_programmed_cs_cd);
+
+/*
+ * Re-program the HDMI video format (colour space, colour depth and the AVI
+ * colour indicator) without touching the mode timing.  The metadata injection
+ * switches the output to RGB while a video is already running, so the full
+ * mode set (hdmitx_set_dispmode) must not be used: it would reset the
+ * encoder and the PLL and the TV would lose the picture.
+ */
+void hdmitx_reconfigure_video_format_hw(void)
+{
+	struct hdmitx_dev *hdev = get_hdmitx_device();
+
+	if (hdev == NULL)
+		return;
+	hdmitx_set_hw(hdev);
 }
+EXPORT_SYMBOL(hdmitx_reconfigure_video_format_hw);
