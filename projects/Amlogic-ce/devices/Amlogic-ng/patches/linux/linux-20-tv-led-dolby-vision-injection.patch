+static int dv_hex2bin(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+/*
+ * Parse the hex string handed over from user space.  Returns the
+ * number of bytes parsed, or a negative error code.
+ */
+/* A Display Management wire payload, not a compressed RPU NAL.
+ * The reference layout has a 70-byte fixed header, a block count at byte
+ * 70, then BE32 length / level / data extension records. All extensions
+ * must fit exactly. The serializer sets a 12-bit, 4:2:2 HDMI signal.
+ */
+static bool dv_injection_block_length(u8 level, u32 length)
+{
+	switch (level) {
+	case 1: case 3: return length == 6;
+	case 2: return length == 14;
+	case 4: case 11: return length == 4;
+	case 5: case 6: return length == 8;
+	case 8: return length == 13 || length == 15 || length == 17 ||
+		       length == 23 || length == 29;
+	case 9: return length == 1;
+	case 10: return length == 6 || length == 22;
+	case 254: return length == 2;
+	case 255: return length == 6;
+	default: return false;
+	}
+}
+
+/*
+ * Walk the extension records of a Display Management payload.
+ *
+ * max_pad is the number of trailing zero bytes the caller is willing to
+ * accept behind the last record, and eff_len receives the length of the
+ * metadata without that padding.  Only the decoder auxiliary path passes a
+ * non-zero max_pad: the sink rounds the length it reports up to 32 bytes, so
+ * a payload of 136 bytes of metadata reaches us as 157 bytes.  Every other
+ * caller passes 0 and keeps the exact-length rule.
+ *
+ * The padding is accepted only when it is zero and no longer than the
+ * allowance, and the walked length is what has to fit in
+ * DV_INJ_MAX_METADATA_SIZE: a 594-byte payload with padding behind it is
+ * still valid, while 595 bytes of real metadata is not.  A block count that
+ * is too small cannot hide behind the padding either, because the leftover
+ * record always starts with a non-zero length field.
+ */
+static int dv_injection_walk_metadata(const u8 *data, u32 size, u32 max_pad,
+				      u32 *eff_len)
+{
+	u32 offset = 71, i, length, pad;
+
+	if (!data || size < 71 || size > DV_INJ_MAX_METADATA_SIZE + max_pad)
+		return -EINVAL;
+	if (strict_dm_format &&
+	    (data[60] != 12 || data[61] > 2 || data[62] > 1 || data[63] > 1))
+		return -EINVAL;
+	for (i = 0; i < data[70]; i++) {
+		if (size - offset < 5)
+			return -EINVAL;
+		length = ((u32)data[offset] << 24) |
+			 ((u32)data[offset + 1] << 16) |
+			 ((u32)data[offset + 2] << 8) | data[offset + 3];
+		offset += 5;
+		if (!dv_injection_block_length(data[offset - 1], length) ||
+		    length > size - offset)
+			return -EINVAL;
+		offset += length;
+	}
+	if (offset > size)
+		return -EINVAL;
+	pad = size - offset;
+	if (pad > max_pad)
+		return -EINVAL;
+	for (i = offset; i < size; i++) {
+		if (data[i])
+			return -EINVAL;
+	}
+	if (offset > DV_INJ_MAX_METADATA_SIZE)
+		return -EINVAL;
+	if (eff_len)
+		*eff_len = offset;
+	return 0;
+}
+
+static int dv_injection_validate_metadata(const u8 *data, u32 size)
+{
+	return dv_injection_walk_metadata(data, size, 0, NULL);
+}
+
+static int dv_injection_parse_metadata(const char *hex, u8 *out)
+{
+	size_t len, i;
+
+	if (!hex || !hex[0])
+		return -EINVAL;
+	len = strlen(hex);
+	if ((len & 1) || len / 2 > DV_INJ_MAX_METADATA_SIZE)
+		return -EINVAL;
+	for (i = 0; i < len / 2; i++) {
+		int hi = dv_hex2bin(hex[i * 2]);
+		int lo = dv_hex2bin(hex[i * 2 + 1]);
+
+		if (hi < 0 || lo < 0)
+			return -EINVAL;
+		out[i] = (hi << 4) | lo;
+	}
+	if (dv_metadata_len && dv_metadata_len != len / 2)
+		return -EINVAL;
+	if (dv_injection_validate_metadata(out, len / 2))
+		return -EINVAL;
+	return len / 2;
+}
+
+/* CRC32 as used by the Dolby Vision metadata packets */
+static u32 dv_injection_crc32(const u8 *data, u32 size)
+{
+	u32 crc = 0xFFFFFFFF;
+	u32 i;
+	u32 j;
+
+	for (i = 0; i < size; i++) {
+		crc ^= (u32)data[i] << 24;
+		for (j = 0; j < 8; j++) {
+			if (crc & 0x80000000)
+				crc = (crc << 1) ^ 0x04C11DB7;
+			else
+				crc <<= 1;
+		}
+	}
+	return crc;
+}
+
+/*
+ * The budget keeps the interrupt path free of work once the interesting frames
+ * have been captured: the counter is decremented with a compare-and-swap so
+ * the producer and the vsync never both spend the last slot.
+ */
+static bool dv_inj_diag_take(atomic_t *left)
+{
+	int v = atomic_read(left);
+
+	while (v > 0) {
+		if (atomic_cmpxchg(left, v, v - 1) == v)
+			return true;
+		v = atomic_read(left);
+	}
+	return false;
+}
