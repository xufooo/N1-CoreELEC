+/* Read-only snapshot of the format the HDMI side believes it drives.  Used by
+ * the injection's diagnostic trace only: nothing here reprograms anything.
+ */
+void hdmitx_dv_injection_format(u32 *vic, u32 *cs, u32 *cd, u32 *cr,
+				u32 *ready)
+{
+	struct hdmi_format_para *para = READ_ONCE(hdmitx_device.para);
+
+	if (vic)
+		*vic = para ? (u32)para->vic : 0xffffffff;
+	if (cs || cd) {
+		u32 pcs = 0xffffffff, pcd = 0xffffffff;
