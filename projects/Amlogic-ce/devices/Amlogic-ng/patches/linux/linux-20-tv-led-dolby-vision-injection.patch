+static void form_dv_sei_payload_from_hdr10plus(uint8_t *hdr10p_sei_payload, uint16_t payload_size, uint8_t* dm_metadata, uint32_t max_display_mastering_luminance, uint32_t min_display_mastering_luminance){
+    struct vframe_hdr_plus_sei hdr_plus_data;
+	uint8_t i;
+
+    memset(&hdr_plus_data, 0, sizeof(struct vframe_hdr_plus_sei));
+    parser_hdr10_plus_metadata(hdr10p_sei_payload, payload_size, &hdr_plus_data);
+
+    // max_pq
+    uint16_t max_distribution_maxrgb_percentiles = 0;
+    for(i = 0; i < hdr_plus_data.num_distribution_maxrgb_percentiles[0]; i++){
+        if(hdr_plus_data.distribution_maxrgb_percentiles[0][i] > max_distribution_maxrgb_percentiles){
+            max_distribution_maxrgb_percentiles = hdr_plus_data.distribution_maxrgb_percentiles[0][i];
+        }
+    }
+    uint16_t max_pq = pq_lookup[max_distribution_maxrgb_percentiles];
+
+    // avg_pq
+    uint16_t avg_pq = pq_lookup[hdr_plus_data.average_maxrgb[0]];
+
+    // min_pq
+    uint16_t min_pq = 0;
+
+    // L1 fix
+    uint16_t L1_min_pq = min_pq;
+    uint16_t L1_max_pq = clamp16(max_pq, (uint16_t) L1_MAX_PQ_MIN_VALUE, (uint16_t) L1_MAX_PQ_MAX_VALUE);
+    uint16_t L1_avg_pq = clamp16(avg_pq, (uint16_t) L1_AVG_PQ_MIN_VALUE_CMV40, L1_max_pq - 1);
+
+	dv_injection_log(2, "L1_min_pq from HDR10+ is: %d\n", L1_min_pq);
+	dv_injection_log(2, "L1_max_pq from HDR10+ is: %d\n", L1_max_pq);
+	dv_injection_log(2, "L1_avg_pq from HDR10+ is: %d\n", L1_avg_pq);
+
+    // Set L1 
+    extension_block ext_block;
+	ext_block.level = 1;
+    DoviExtMetadataBlockLevel1 L1;
+
+    find_ext_block(&ext_block, dm_metadata);
+    get_L1(&L1, &ext_block);
+    L1.min_pq = L1_min_pq;
+    L1.max_pq = L1_max_pq;
+    L1.avg_pq = L1_avg_pq;
+    set_L1(&L1, &ext_block);
+
+    // Set source display info
+    // min
+    uint16_t source_min_pq;
+    if(min_display_mastering_luminance == 0){
+        source_min_pq = 0;
+    } else if (min_display_mastering_luminance == 1){
+        source_min_pq = 7;
+    } else if (min_display_mastering_luminance == 10){
+        source_min_pq = 19;
+    } else if (min_display_mastering_luminance == 20){
+        source_min_pq = 38;
+    } else if (min_display_mastering_luminance == 50){
+        source_min_pq = 62;
+    } else {
+        source_min_pq = 0;
+    }
+    dm_metadata[SOURCE_MIN_PQ_OFFSET] = source_min_pq >> 8;
+    dm_metadata[SOURCE_MIN_PQ_OFFSET + 1] = source_min_pq & 0xFF;
+
+    // max
+    uint16_t source_max_pq;
+    if(max_display_mastering_luminance == 10000000){
+        source_max_pq = 3079;
+    } else if (max_display_mastering_luminance == 20000000){
+        source_max_pq = 3388;
+    } else if (max_display_mastering_luminance == 40000000){
+        source_max_pq = 3696;
+    } else if (max_display_mastering_luminance == 100000000){
+        source_max_pq = 4095;
+    } else {
+        source_max_pq = 3079;
+    }
+    dm_metadata[SOURCE_MAX_PQ_OFFSET] = source_max_pq >> 8;
+    dm_metadata[SOURCE_MAX_PQ_OFFSET + 1] = source_max_pq & 0xFF;
+}
