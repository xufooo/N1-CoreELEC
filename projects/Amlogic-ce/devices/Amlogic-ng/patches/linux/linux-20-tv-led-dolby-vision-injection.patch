+/* ---- L1/L5 metadata layer, ported from the reference implementation ---- */
+static int L5_adjust_mode = 3; /* negative disables L5 handling */
+static bool L1_adjust = true;  /* author's L1 handling switch */ /* 0 removed, 1 original, 2 metadata, 3 auto */
+module_param(L5_adjust_mode, int, 0644);
+module_param(L1_adjust, bool, 0644);
+MODULE_PARM_DESC(L1_adjust, "\n adjust Level 1 luminance\n");
+module_param(osd_L5_timeout_ms, uint, 0644);
+MODULE_PARM_DESC(osd_L5_timeout_ms, "\n quiet window after OSD ioctls\n");
+MODULE_PARM_DESC(L5_adjust_mode, "\n Level 5 active area handling mode\n");
+
+typedef struct {
+	uint8_t *data;
+    uint8_t level;
+    uint32_t length;
+} extension_block;
+
+typedef struct {
+    uint16_t active_area_left_offset;
+    uint16_t active_area_right_offset;
+    uint16_t active_area_top_offset;
+    uint16_t active_area_bottom_offset;
+} DoviExtMetadataBlockLevel5;
+
+static void get_L5(DoviExtMetadataBlockLevel5* L5, extension_block* ext_block){
+    L5->active_area_left_offset = (ext_block->data[0] << 8) | ext_block->data[1];
+    L5->active_area_right_offset = (ext_block->data[2] << 8) | ext_block->data[3];
+    L5->active_area_top_offset = (ext_block->data[4] << 8) | ext_block->data[5];
+    L5->active_area_bottom_offset = (ext_block->data[6] << 8) | ext_block->data[7];
+}
+
+static void set_L5(DoviExtMetadataBlockLevel5* L5, extension_block* ext_block){
+    ext_block->data[0] = L5->active_area_left_offset >> 8;
+    ext_block->data[1] = L5->active_area_left_offset & 0xFF;
+
+    ext_block->data[2] = L5->active_area_right_offset >> 8;
+    ext_block->data[3] = L5->active_area_right_offset & 0xFF;
+
+    ext_block->data[4] = L5->active_area_top_offset >> 8;
+    ext_block->data[5] = L5->active_area_top_offset & 0xFF;
+
+    ext_block->data[6] = L5->active_area_bottom_offset >> 8;
+    ext_block->data[7] = L5->active_area_bottom_offset & 0xFF;
+}
+
+typedef struct {
+    uint16_t min_pq;
+    uint16_t max_pq;
+    uint16_t avg_pq;
+} DoviExtMetadataBlockLevel1;
+
+void get_L1(DoviExtMetadataBlockLevel1* L1, extension_block* ext_block){
+    L1->min_pq = (ext_block->data[0] << 8) | ext_block->data[1];
+    L1->max_pq = (ext_block->data[2] << 8) | ext_block->data[3];
+    L1->avg_pq = (ext_block->data[4] << 8) | ext_block->data[5];
+}
+
+void set_L1(DoviExtMetadataBlockLevel1* L1, extension_block* ext_block){
+    ext_block->data[0] = L1->min_pq >> 8;
+    ext_block->data[1] = L1->min_pq & 0xFF;
+
+    ext_block->data[2] = L1->max_pq >> 8;
+    ext_block->data[3] = L1->max_pq & 0xFF;
+
+    ext_block->data[4] = L1->avg_pq >> 8;
+    ext_block->data[5] = L1->avg_pq & 0xFF;
+}
+
+static void find_ext_block(extension_block* ext_block, uint8_t* dm_metadata){
+
+    uint8_t num_blocks = dm_metadata[70];
+    uint8_t *block_ptr = &dm_metadata[71];
+    uint8_t i;
+    uint32_t j;
+
+    ext_block->length = 0;
+    ext_block->data = NULL;
+
+	dv_injection_log(3, "num_blocks: %d\n", num_blocks);
+    for(i = 0; i < num_blocks; i++){
+        uint32_t block_length = (block_ptr[0] << 24) | (block_ptr[1] << 16) | (block_ptr[2] << 8) | (block_ptr[3]);
+        uint8_t block_level = block_ptr[4];
+        dv_injection_log(3, "\n");
+        dv_injection_log(3, "block: %d\n", i+1);
+        dv_injection_log(3, "block_length: %d\n", block_length);
+        dv_injection_log(3, "block_level: %d\n",  block_level);
+        for(j = 0; j < block_length; j++){
+            dv_injection_log(3, "0x%02x, ",  block_ptr[5+j]);
+        }
+        dv_injection_log(3, "\n");
+
+        if(block_level == ext_block->level){
+            ext_block->length = block_length;
+            ext_block->data =  &block_ptr[5];
+			break;
+        }
+        block_ptr += (block_length + 5);
+    }
+}
+
+typedef enum {
+    REMOVED = 0,
+    ORIGINAL = 1,
+    METADATA_ONLY = 2,
+    AUTO = 3,
+} L5_adjust_t;
+
+static bool auto_set_L5(DoviExtMetadataBlockLevel5* L5, uint16_t video_width, uint16_t video_height, uint16_t screen_width, uint16_t screen_height, L5_adjust_t mode){
+    bool changed = false;
+    uint16_t vert_diff;
+    uint16_t horz_diff;
+
+	if(time_before(jiffies, last_osd_ioctl_time + msecs_to_jiffies(osd_L5_timeout_ms))){
+		dv_injection_log(2, "removing L5 for gui\n");
+		L5->active_area_left_offset = 0;
+		L5->active_area_right_offset = 0;
+		L5->active_area_top_offset = 0;
+		L5->active_area_bottom_offset = 0;
+		mode = METADATA_ONLY;
+	}
+
+    switch (mode) {
+        case REMOVED:
+        default:
+            dv_injection_log(2, "removing L5\n");
+            L5->active_area_left_offset = 0;
+            L5->active_area_right_offset = 0;
+            L5->active_area_top_offset = 0;
+            L5->active_area_bottom_offset = 0;
+            changed = true;
+            break;
+        case ORIGINAL:
+            dv_injection_log(2, "untouched L5\n");
+            break;
+        case AUTO:
+            dv_injection_log(2, "auto L5\n");
+            if(video_width == 1920){
+                dv_injection_log(2, "adjusting for 1920 with 4K output\n");
+                // 1920 video, played back with a 4K output, double offsets to match
+                video_width *= 2;
+                video_height *= 2;
+                L5->active_area_left_offset *= 2;
+                L5->active_area_right_offset *= 2;
+                L5->active_area_top_offset *= 2;
+                L5->active_area_bottom_offset *= 2;
+            }
+
+            vert_diff = (screen_height - video_height) / 2;
+            dv_injection_log(2, "vert_diff: %d\n", vert_diff);
+            L5->active_area_top_offset += vert_diff;
+            L5->active_area_bottom_offset += vert_diff;
+
+            horz_diff = (screen_width - video_width) / 2;
+            dv_injection_log(2, "horz_diff: %d\n", horz_diff);
+            L5->active_area_left_offset += horz_diff;
+            L5->active_area_right_offset += horz_diff;
+
+            changed = true;
+
+        case METADATA_ONLY:
+            dv_injection_log(2, "Checking if L5 adjustment needed for metadata\n");
+
+            if(L5->active_area_top_offset < MAX_METADATA_ROWS_4K){
+               dv_injection_log(2, "adjusting L5 for metadata\n");
+               L5->active_area_top_offset = MAX_METADATA_ROWS_4K;
+                changed = true;
+            }
+    }
+
+    return changed;
+}
+
+static void	modify_L5_data(struct vframe_s *vf, uint8_t *dm_metadata){
+	extension_block ext_block;
+	ext_block.level = 5;
+
+	find_ext_block(&ext_block, dm_metadata);
+	if(ext_block.data){
+		DoviExtMetadataBlockLevel5 L5;
+		uint16_t video_width = (uint16_t) vf->compWidth;
+		uint16_t video_height = (uint16_t) vf->compHeight;
+		uint16_t screen_width = 3840;
+		uint16_t screen_height = 2160;
+		get_L5(&L5, &ext_block);
+		bool L5_changed = auto_set_L5(&L5, video_width, video_height, screen_width, screen_height, (L5_adjust_t) L5_adjust_mode);
+		if(L5_changed){
+			set_L5(&L5, &ext_block);
+		}
+	}
+}
+
+bool auto_set_L1(uint8_t *dm_metadata){
+    bool metadata_changed = false;
+    uint16_t source_min_pq;
+    uint16_t source_max_pq;
+    extension_block ext_block;
+	ext_block.level = 1;
+
+	find_ext_block(&ext_block, dm_metadata);
+    if(ext_block.data){
+		DoviExtMetadataBlockLevel1 L1;
+		get_L1(&L1, &ext_block);
+        source_min_pq = (dm_metadata[SOURCE_MIN_PQ_OFFSET] << 8) | dm_metadata[SOURCE_MIN_PQ_OFFSET + 1];
+        source_max_pq = (dm_metadata[SOURCE_MAX_PQ_OFFSET] << 8) | dm_metadata[SOURCE_MAX_PQ_OFFSET + 1];
+        if(L1.min_pq < source_min_pq){
+			dv_injection_log(2, "L1.min_pq adjusted to source_min_pq. Changed from %u to %u\n", L1.min_pq, source_min_pq);
+            L1.min_pq = source_min_pq;
+            metadata_changed = true;
+        }
+        if(L1.max_pq > source_max_pq){
+            dv_injection_log(2, "L1.max_pq adjusted to source_max_pq. Changed from %u to %u\n", L1.max_pq, source_max_pq);
+            L1.max_pq = source_max_pq;
+            metadata_changed = true;
+        }
+		if(metadata_changed){
+			set_L1(&L1, &ext_block);
+		}
+	}
+
+    return metadata_changed;
+}
