diff --git a/drivers/amlogic/media/video_sink/dv_injection.c b/drivers/amlogic/media/video_sink/dv_injection.c
new file mode 100644
index 0000000000..4444444444
--- /dev/null
+++ b/drivers/amlogic/media/video_sink/dv_injection.c
@@ -0,0 +1,812 @@
+++ b/drivers/amlogic/media/video_sink/dv_injection.c
+/*
+ * Amlogic TV-led Dolby Vision metadata injection (Phicomm N1 / GXL)
+ *
+ * Ported from the publicly published "dv_injection" implementation
+ * (doppingkoala/common_drivers, dv_injection.c) and adapted to the
+ * CoreELEC 4.9 (amlogic-4.9-20) tree used by this project.
+ *
+ * Principle (TV-led Dolby Vision):
+ *   The box does not reshape the picture.  Instead the Dolby Vision
+ *   Display Management (DM) metadata is packetised into 128 byte
+ *   "Dolby Vision metadata packets", every bit of a packet is turned
+ *   into one picture pixel, and those pixels are written into the top
+ *   rows of the OSD/GUI canvas.  Together with a Dolby VSIF packet the
+ *   TV performs display management. Source pixel reshaping (notably
+ *   Profile 5) is a separate operation, not implemented by this module.
+ *
+ *   This is a disabled-by-default static-DM transport diagnostic. It
+ *   is not a complete Profile 5 decoder or a per-frame metadata pipeline.
+ *
+ * Metadata source:
+ *   The DM metadata bytes are handed over from user space (Kodi) via
+ *   the "dv_metadata" module parameter (hex string).  Kodi already
+ *   links libdovi, so it can extract the RPU/DM block from the stream.
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include <linux/version.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/workqueue.h>
+#include <linux/timer.h>
+#include <linux/string.h>
+#include <linux/io.h>
+#include <linux/mm.h>
+#include <linux/ctype.h>
+#include <linux/slab.h>
+#include <linux/fb.h>
+#include <linux/console.h>
+#include <linux/mutex.h>
+
+#include <linux/amlogic/media/vfm/vframe.h>
+#include <linux/amlogic/media/vout/vinfo.h>
+#include <linux/amlogic/media/vout/vout_notify.h>
+#include <linux/amlogic/media/canvas/canvas.h>
+
+#include <linux/amlogic/media/video_sink/dv_injection.h>
+
+/* Dolby Vision metadata packet format (as used by the reference
+ * implementation): 128 byte packets, CRC32 in the last 4 bytes.
+ */
+#define DV_INJ_NUM_BYTES_PER_PACKET	128
+#define DV_INJ_CRC_OFFSET		124
+#define DV_INJ_MAX_NUM_HDR_DM_PACKETS	5
+#define DV_INJ_NUM_HDR_DM_PACKET_REPEATS	3
+#define DV_INJ_BITS_PER_BYTE		8
+#define DV_INJ_PIXELS_PER_PKT		(DV_INJ_NUM_BYTES_PER_PACKET * \
+					 DV_INJ_BITS_PER_BYTE)
+#define DV_INJ_MAX_METADATA_SIZE	594
+
+/* pixel patterns used to carry one bit */
+#define DV_INJ_ODD_INJECTION		0xFFFFFFFF
+#define DV_INJ_EVEN_INJECTION		0xFF000000
+
+enum hdr_dm_packet_type {
+	DV_INJ_FIRST_AND_ONLY_PKT = 0,
+	DV_INJ_FIRST_OF_MULTIPLE_PKT,
+	DV_INJ_CONTINUING_PKT,
+	DV_INJ_LAST_OF_MULTIPLE_PKT
+};
+
+struct hdr_dm_packet {
+	u8 num_pkts;
+	u8 byte_data[DV_INJ_MAX_NUM_HDR_DM_PACKETS][DV_INJ_NUM_BYTES_PER_PACKET];
+	u32 pixel_data[DV_INJ_MAX_NUM_HDR_DM_PACKETS][DV_INJ_PIXELS_PER_PKT];
+};
+
+/*
+ * One slot per decoder frame index.  The DM metadata is captured when a
+ * frame leaves the decoder and consumed when that same frame reaches the
+ * display, which is how the reference implementation pairs them.
+ */
+#define DV_INJ_POOL_SIZE 64
+#define DV_SEI_TYPE 0x01000000
+#define DV_SEI_VDR_HEADER_LENGTH 3
+#define DV_SEI_VDR_MIN_BODY 71
+
+struct dv_inj_slot {
+	bool valid;
+	u8 num_pkts;
+	u8 byte_data[DV_INJ_MAX_NUM_HDR_DM_PACKETS][DV_INJ_NUM_BYTES_PER_PACKET];
+};
+
+static struct dv_inj_slot dv_inj_pool[DV_INJ_POOL_SIZE];
+static struct dv_inj_slot dv_inj_static_slot;
+
+/* 0: per-frame metadata from the decoder (playback), 1: static buffer (debug) */
+static unsigned int vdr_dm_data_source;
+module_param(vdr_dm_data_source, uint, 0644);
+MODULE_PARM_DESC(vdr_dm_data_source,
+		 "\n 0 = per-frame metadata from the decoder, 1 = static buffer\n");
+
+static bool dv_injection_enable;
+static bool dv_injection_active;
+static DEFINE_MUTEX(dv_injection_lock);
+static int dv_injection_enable_set(const char *val, const struct kernel_param *kp);
+static const struct kernel_param_ops dv_enable_ops = {
+	.set = dv_injection_enable_set,
+	.get = param_get_bool,
+};
+module_param_cb(dv_injection_enable, &dv_enable_ops, &dv_injection_enable, 0644);
+MODULE_PARM_DESC(dv_injection_enable,
+		 "\n enable TV-led Dolby Vision metadata injection\n");
+
+/* The DM metadata is handed over from user space as a hex string.
+ * A fixed buffer keeps the parameter write bounded; it is re-parsed
+ * into DM metadata whenever user space writes it.
+ */
+static char dv_metadata[DV_INJ_MAX_METADATA_SIZE * 2 + 1];
+static unsigned int dv_metadata_len;
+module_param(dv_metadata_len, uint, 0644);
+MODULE_PARM_DESC(dv_metadata_len,
+		 "\n length of the DM metadata in bytes (0 = derive from hex)\n");
+
+static unsigned int osd_canvas = 0x40;
+module_param(osd_canvas, uint, 0644);
+MODULE_PARM_DESC(osd_canvas,
+		 "\n canvas index the metadata is written to\n");
+
+/* Derived from the actual fb0 stride and visible height; never guessed. */
+static unsigned int osd_pixel_offset;
+module_param(osd_pixel_offset, uint, 0444);
+MODULE_PARM_DESC(osd_pixel_offset,
+		 "\n derived framebuffer page size in pixels (read only)\n");
+
+static unsigned int bytes_per_pixel = 4;
+module_param(bytes_per_pixel, uint, 0644);
+MODULE_PARM_DESC(bytes_per_pixel,
+		 "\n bytes per pixel of the target canvas (4 = ARGB32)\n");
+
+static unsigned int odd_pattern = DV_INJ_ODD_INJECTION;
+module_param(odd_pattern, uint, 0444);
+MODULE_PARM_DESC(odd_pattern, "\n pixel pattern for a set bit\n");
+
+static unsigned int even_pattern = DV_INJ_EVEN_INJECTION;
+module_param(even_pattern, uint, 0444);
+MODULE_PARM_DESC(even_pattern, "\n pixel pattern for a cleared bit\n");
+
+static unsigned int packet_repeat = 1;
+module_param(packet_repeat, uint, 0644);
+MODULE_PARM_DESC(packet_repeat, "\n how often every packet is repeated\n");
+
+static bool always_send_vsif = true;
+module_param(always_send_vsif, bool, 0644);
+MODULE_PARM_DESC(always_send_vsif, "\n send the Dolby VSIF on every frame\n");
+
+/* Keep the old switch for diagnostics, but only the checked canvas path
+ * (0) is supported. The former EMP experiment is deliberately unavailable.
+ */
+static unsigned int dv_injection_path;
+module_param(dv_injection_path, uint, 0644);
+MODULE_PARM_DESC(dv_injection_path, "\n checked canvas path only (0)\n");
+
+/* Write 1 to dump the sink Dolby Vision capabilities to dmesg. */
+static unsigned int dv_info_dump;
+static void dv_injection_dump_sink_info(void);
+
+static int dv_info_dump_set(const char *val, const struct kernel_param *kp)
+{
+	int ret = param_set_uint(val, kp);
+
+	if (ret == 0)
+		dv_injection_dump_sink_info();
+	return ret;
+}
+
+static const struct kernel_param_ops dv_info_dump_ops = {
+	.set = dv_info_dump_set,
+	.get = param_get_uint,
+};
+
+module_param_cb(dv_info_dump, &dv_info_dump_ops, &dv_info_dump, 0644);
+MODULE_PARM_DESC(dv_info_dump,
+		 "\n write 1 to dump the sink Dolby Vision capabilities\n");
+
+static unsigned int dv_injection_log_level;
+module_param(dv_injection_log_level, uint, 0644);
+MODULE_PARM_DESC(dv_injection_log_level, "\n dv injection log level\n");
+
+#define dv_injection_log(level, x...) \
+	do { \
+		if ((level) <= dv_injection_log_level) \
+			pr_info(x); \
+	} while (0)
+
+static u8 dm_metadata[DV_INJ_MAX_METADATA_SIZE];
+static u32 dm_metadata_size;
+static struct hdr_dm_packet dm_packet;
+
+static int dv_hex2bin(char c)
+{
+	if (c >= '0' && c <= '9')
+		return c - '0';
+	if (c >= 'a' && c <= 'f')
+		return c - 'a' + 10;
+	if (c >= 'A' && c <= 'F')
+		return c - 'A' + 10;
+	return -1;
+}
+
+/*
+ * Parse the hex string handed over from user space.  Returns the
+ * number of bytes parsed, or a negative error code.
+ */
+/* A Display Management wire payload, not a compressed RPU NAL.
+ * The reference layout has a 70-byte fixed header, a block count at byte
+ * 70, then BE32 length / level / data extension records. All extensions
+ * must fit exactly. The serializer sets a 12-bit, 4:2:2 HDMI signal.
+ */
+static bool dv_injection_block_length(u8 level, u32 length)
+{
+	switch (level) {
+	case 1: case 3: return length == 6;
+	case 2: return length == 14;
+	case 4: case 11: return length == 4;
+	case 5: case 6: return length == 8;
+	case 8: return length == 13 || length == 15 || length == 17 ||
+		       length == 23 || length == 29;
+	case 9: return length == 1;
+	case 10: return length == 6 || length == 22;
+	case 254: return length == 2;
+	case 255: return length == 6;
+	default: return false;
+	}
+}
+
+static int dv_injection_validate_metadata(const u8 *data, u32 size)
+{
+	u32 offset = 71, i, length;
+
+	if (!data || size < 71 || size > DV_INJ_MAX_METADATA_SIZE)
+		return -EINVAL;
+	if (data[60] != 12 || data[61] > 2 || data[62] != 1 || data[63] > 1)
+		return -EINVAL;
+	for (i = 0; i < data[70]; i++) {
+		if (size - offset < 5)
+			return -EINVAL;
+		length = ((u32)data[offset] << 24) |
+			 ((u32)data[offset + 1] << 16) |
+			 ((u32)data[offset + 2] << 8) | data[offset + 3];
+		offset += 5;
+		if (!dv_injection_block_length(data[offset - 1], length) ||
+		    length > size - offset)
+			return -EINVAL;
+		offset += length;
+	}
+	return offset == size ? 0 : -EINVAL;
+}
+
+static int dv_injection_parse_metadata(const char *hex, u8 *out)
+{
+	size_t len, i;
+
+	if (!hex || !hex[0])
+		return -EINVAL;
+	len = strlen(hex);
+	if ((len & 1) || len / 2 > DV_INJ_MAX_METADATA_SIZE)
+		return -EINVAL;
+	for (i = 0; i < len / 2; i++) {
+		int hi = dv_hex2bin(hex[i * 2]);
+		int lo = dv_hex2bin(hex[i * 2 + 1]);
+
+		if (hi < 0 || lo < 0)
+			return -EINVAL;
+		out[i] = (hi << 4) | lo;
+	}
+	if (dv_metadata_len && dv_metadata_len != len / 2)
+		return -EINVAL;
+	if (dv_injection_validate_metadata(out, len / 2))
+		return -EINVAL;
+	return len / 2;
+}
+
+/* CRC32 as used by the Dolby Vision metadata packets */
+static u32 dv_injection_crc32(const u8 *data, u32 size)
+{
+	u32 crc = 0xFFFFFFFF;
+	u32 i;
+	u32 j;
+
+	for (i = 0; i < size; i++) {
+		crc ^= (u32)data[i] << 24;
+		for (j = 0; j < 8; j++) {
+			if (crc & 0x80000000)
+				crc = (crc << 1) ^ 0x04C11DB7;
+			else
+				crc <<= 1;
+		}
+	}
+	return crc;
+}
+
+static enum hdr_dm_packet_type dv_injection_pkt_type(u8 cur, u8 num)
+{
+	if (cur == 0)
+		return (num == 1) ? DV_INJ_FIRST_AND_ONLY_PKT :
+			DV_INJ_FIRST_OF_MULTIPLE_PKT;
+	return ((cur + 1) != num) ? DV_INJ_CONTINUING_PKT :
+		DV_INJ_LAST_OF_MULTIPLE_PKT;
+}
+
+/*
+ * Split the DM metadata into Dolby Vision metadata packets and turn
+ * every bit into one picture pixel.
+ */
+static int dv_injection_pack_bytes(u8 byte_data[][DV_INJ_NUM_BYTES_PER_PACKET],
+				   u8 *out_num_pkts, const u8 *metadata, u32 size)
+{
+	u8 pkt_num;
+	u8 *cur_pkt;
+	u32 cur_pkt_len;
+	u32 last_pkt_len;
+	u32 bytes_written = 0;
+	u32 pkt_offset;
+	u32 num_pkts = 1;
+	u32 crc;
+	u8 *crc_ptr = (u8 *)&crc;
+	enum hdr_dm_packet_type pkt_type;
+
+	if (!metadata || !size || size > DV_INJ_MAX_METADATA_SIZE)
+		return -EINVAL;
+
+	last_pkt_len = size;
+	if (last_pkt_len > 119) {
+		last_pkt_len -= 119;
+		while (last_pkt_len > 121) {
+			last_pkt_len -= 121;
+			num_pkts++;
+		}
+		if (last_pkt_len > 0)
+			num_pkts++;
+	}
+	if (num_pkts > DV_INJ_MAX_NUM_HDR_DM_PACKETS)
+		return -EINVAL;
+
+	memset(byte_data, 0,
+	       num_pkts * DV_INJ_NUM_BYTES_PER_PACKET);
+
+	for (pkt_num = 0; pkt_num < num_pkts; pkt_num++) {
+		cur_pkt = byte_data[pkt_num];
+		pkt_type = dv_injection_pkt_type(pkt_num, (u8)num_pkts);
+
+		if (pkt_type == DV_INJ_FIRST_AND_ONLY_PKT ||
+		    pkt_type == DV_INJ_FIRST_OF_MULTIPLE_PKT) {
+			cur_pkt[0] = (pkt_type == DV_INJ_FIRST_AND_ONLY_PKT) ?
+				0 : 0x40;
+			cur_pkt[1] = metadata[0];
+			cur_pkt[2] = 0;
+			cur_pkt[3] = (u8)(size >> 8);
+			cur_pkt[4] = (u8)(size & 0xFF);
+			cur_pkt_len = (pkt_type == DV_INJ_FIRST_AND_ONLY_PKT) ?
+				last_pkt_len : 119;
+			pkt_offset = 5;
+		} else {
+			cur_pkt[0] = (pkt_type == DV_INJ_LAST_OF_MULTIPLE_PKT) ?
+				0xC0 : 0x80;
+			cur_pkt[1] = metadata[0];
+			cur_pkt[2] = 0;
+			cur_pkt_len = (pkt_type == DV_INJ_LAST_OF_MULTIPLE_PKT) ?
+				last_pkt_len : 121;
+			pkt_offset = 3;
+		}
+
+		memcpy(&cur_pkt[pkt_offset], &metadata[bytes_written],
+		       cur_pkt_len);
+		bytes_written += cur_pkt_len;
+
+		if (bytes_written >= size)
+			memset(&cur_pkt[pkt_offset + cur_pkt_len], 0,
+			       DV_INJ_NUM_BYTES_PER_PACKET - 4 -
+			       pkt_offset - cur_pkt_len);
+
+		crc = dv_injection_crc32(cur_pkt, DV_INJ_NUM_BYTES_PER_PACKET - 4);
+		cur_pkt[DV_INJ_CRC_OFFSET] = crc_ptr[3];
+		cur_pkt[DV_INJ_CRC_OFFSET + 1] = crc_ptr[2];
+		cur_pkt[DV_INJ_CRC_OFFSET + 2] = crc_ptr[1];
+		cur_pkt[DV_INJ_CRC_OFFSET + 3] = crc_ptr[0];
+	}
+
+	*out_num_pkts = (u8)num_pkts;
+	return 0;
+}
+
+/* bit -> pixel, into the scratch buffer used by the canvas writer */
+static void dv_injection_expand_pixels(const struct dv_inj_slot *slot)
+{
+	u8 pkt_num, byte_num, bit_num, injected_byte;
+
+	dm_packet.num_pkts = slot->num_pkts;
+	for (pkt_num = 0; pkt_num < slot->num_pkts; pkt_num++) {
+		memcpy(dm_packet.byte_data[pkt_num], slot->byte_data[pkt_num],
+		       DV_INJ_NUM_BYTES_PER_PACKET);
+		for (byte_num = 0; byte_num < DV_INJ_NUM_BYTES_PER_PACKET;
+		     byte_num++) {
+			injected_byte = slot->byte_data[pkt_num][byte_num];
+			for (bit_num = 0; bit_num < DV_INJ_BITS_PER_BYTE;
+			     bit_num++) {
+				dm_packet.pixel_data[pkt_num]
+					[byte_num * DV_INJ_BITS_PER_BYTE +
+					 bit_num] =
+					((injected_byte >> (7 - bit_num)) & 1) ?
+					odd_pattern : even_pattern;
+			}
+		}
+	}
+}
+
+static int dv_injection_form_packets(const u8 *metadata, u32 size)
+{
+	return dv_injection_pack_bytes(dm_packet.byte_data,
+				       &dm_packet.num_pkts, metadata, size);
+}
+
+/* Locate the Dolby Vision payload inside the decoder SEI buffer.  The
+ * reference implementation wraps the serialised DM data as
+ * 0x7C 0x01 0xFF inside a type 0x01000000 (DV) SEI block.
+ */
+static int dv_injection_find_dv_sei(const void *sei_data, u32 sei_size,
+				    const u8 **payload, u32 *payload_len)
+{
+	const u8 *p = (const u8 *)sei_data;
+	u32 offset = 0;
+
+	if (!p || !sei_size)
+		return -EINVAL;
+
+	while (offset + 8 <= sei_size) {
+		u32 size = ((u32)p[0] << 24) | ((u32)p[1] << 16) |
+			   ((u32)p[2] << 8) | p[3];
+		u32 type = ((u32)p[4] << 24) | ((u32)p[5] << 16) |
+			   ((u32)p[6] << 8) | p[7];
+
+		p += 8;
+		offset += 8;
+		if (offset + size > sei_size)
+			break;
+		if (type == DV_SEI_TYPE &&
+		    size >= DV_SEI_VDR_HEADER_LENGTH + DV_SEI_VDR_MIN_BODY &&
+		    p[0] == 0x7C && p[1] == 0x01 && p[2] == 0xFF) {
+			*payload = p + DV_SEI_VDR_HEADER_LENGTH;
+			*payload_len = size - DV_SEI_VDR_HEADER_LENGTH;
+			return 0;
+		}
+		p += size;
+		offset += size;
+	}
+	return -ENOENT;
+}
+
+/*
+ * Write the packetised metadata into the top left corner of the OSD
+ * canvas.  This is the "top pixel" embedding the TV expects for
+ * TV-led Dolby Vision.
+ */
+/* Pure checked arithmetic, also exercised by the host regression test. */
+static int dv_injection_canvas_layout(u32 stride, u32 xres, u32 yres,
+				     u32 yvirtual, u64 allocation, u32 num_pkts,
+				     u32 repeat, u64 *page_bytes, u32 *pages)
+{
+	u64 metadata_bytes, total;
+
+	if (!stride || !xres || !yres || !yvirtual || (stride & 3) ||
+	    (u64)xres * 4 > stride || yvirtual % yres ||
+	    !num_pkts || num_pkts > DV_INJ_MAX_NUM_HDR_DM_PACKETS ||
+	    repeat < 1 || repeat > DV_INJ_NUM_HDR_DM_PACKET_REPEATS)
+		return -EINVAL;
+	*pages = yvirtual / yres;
+	if (*pages < 1 || *pages > 3)
+		return -EINVAL;
+	*page_bytes = (u64)stride * yres;
+	total = (u64)stride * yvirtual;
+	metadata_bytes = ((u64)(num_pkts - 1) *
+		DV_INJ_NUM_HDR_DM_PACKET_REPEATS + repeat) *
+		DV_INJ_PIXELS_PER_PKT * 4;
+	if (total > allocation || metadata_bytes > *page_bytes ||
+	    *page_bytes / 4 > 0xffffffffULL)
+		return -EINVAL;
+	return 0;
+}
+
+static int dv_injection_write_canvas(const struct vinfo_s *vinfo)
+{
+	struct canvas_s cs;
+	struct fb_info *info;
+	u64 page_bytes;
+	u32 pages, page, pkt, repeat;
+	u32 canvas_index = READ_ONCE(osd_canvas);
+	u32 repeats = READ_ONCE(packet_repeat);
+	int ret = -EINVAL;
+
+	if (READ_ONCE(bytes_per_pixel) != 4 || canvas_index > 255)
+		return -EINVAL;
+	/* console_lock protects registration/mode changes, fb_info.lock the
+	 * driver's buffer geometry. Never derive a pointer from an arbitrary
+	 * canvas physical address; use fb0's existing mapped screen_base.
+	 */
+	console_lock();
+	info = registered_fb[0];
+	if (!info || !lock_fb_info(info))
+		goto out_console;
+	memset(&cs, 0, sizeof(cs));
+	canvas_read(canvas_index, &cs);
+	if (!info->screen_base || !info->fix.smem_len ||
+	    info->var.bits_per_pixel != 32 ||
+	    cs.addr != info->fix.smem_start ||
+	    cs.width != info->fix.line_length ||
+	    cs.height < info->var.yres_virtual ||
+	    info->var.xres != vinfo->width || info->var.yres != vinfo->height)
+		goto out_fb;
+	ret = dv_injection_canvas_layout(info->fix.line_length,
+		info->var.xres, info->var.yres, info->var.yres_virtual,
+		info->fix.smem_len, dm_packet.num_pkts, repeats,
+		&page_bytes, &pages);
+	if (ret)
+		goto out_fb;
+	osd_pixel_offset = page_bytes / 4;
+	for (page = 0; page < pages; page++) {
+		for (pkt = 0; pkt < dm_packet.num_pkts; pkt++) {
+			for (repeat = 0; repeat < repeats; repeat++) {
+				u64 offset = page * page_bytes +
+					(pkt * DV_INJ_NUM_HDR_DM_PACKET_REPEATS +
+					 repeat) * DV_INJ_PIXELS_PER_PKT * 4;
+
+				memcpy_toio((u8 __iomem *)info->screen_base + offset,
+					dm_packet.pixel_data[pkt], DV_INJ_PIXELS_PER_PKT * 4);
+			}
+		}
+	}
+	/* Order mapped buffer writes before announcing the DV signal. */
+	wmb();
+	ret = 0;
+out_fb:
+	unlock_fb_info(info);
+out_console:
+	console_unlock();
+	if (!ret)
+		dv_injection_log(2, "dv injection: metadata written to canvas %u\n", osd_canvas);
+	return ret;
+}
+
+static int dv_injection_send_vsif(const struct vinfo_s *vinfo)
+{
+	struct dv_vsif_para vsif;
+
+	if (!vinfo || !vinfo->vout_device ||
+	    !vinfo->vout_device->fresh_tx_vsif_pkt ||
+	    !vinfo->vout_device->dv_info ||
+	    vinfo->vout_device->dv_info->ieeeoui != 0x00d046)
+		return -EINVAL;
+
+	memset(&vsif, 0, sizeof(vsif));
+	vsif.ver = 2;
+	vsif.length = 15;
+	vsif.vers.ver2.dobly_vision_signal = 1;	/* DV STD */
+	vsif.vers.ver2.low_latency = 0;
+
+	vinfo->vout_device->fresh_tx_vsif_pkt(EOTF_T_DOLBYVISION,
+					      RGB_8BIT, &vsif, false);
+	dv_injection_log(2, "dv injection: VSIF sent\n");
+	return 0;
+}
+
+/*
+ * Dump what the sink advertises for Dolby Vision.  Both the EMP path and
+ * the VSIF path depend on these values, so logging them turns a silent
+ * -EINVAL from send_emp() into something actionable.
+ */
+static void dv_injection_dump_sink_info(void)
+{
+	struct vinfo_s *vinfo = get_current_vinfo();
+	const struct dv_info *dv;
+
+	if (!vinfo || !vinfo->vout_device || !vinfo->vout_device->dv_info) {
+		pr_info("dv injection: sink reports no Dolby Vision EDID block\n");
+		return;
+	}
+	dv = vinfo->vout_device->dv_info;
+	pr_info("dv injection: sink DV oui=0x%06x ver=%u len=%u emp_cap=%u yuv422_12bit=%u 2160p60=%u dimming=%u dm=%u.%u\n",
+		dv->ieeeoui, dv->ver, dv->length, dv->dv_emp_cap,
+		dv->sup_yuv422_12bit, dv->sup_2160p60hz,
+		dv->sup_global_dimming, dv->dm_major_ver, dv->dm_minor_ver);
+}
+
+static bool dv_inj_ready;
+
+/* Called with dv_injection_lock held. Clearing ownership first permits
+ * the normal HDR/SDR producer to resume and the explicit DV-off packet
+ * restores the AVI colour/range state through the existing HDMI driver.
+ */
+static void dv_injection_deactivate(void)
+{
+	const struct vinfo_s *vinfo;
+
+	if (!dv_injection_active)
+		return;
+	WRITE_ONCE(dv_injection_active, false);
+	vinfo = get_current_vinfo();
+	if (vinfo && vinfo->vout_device &&
+	    vinfo->vout_device->fresh_tx_vsif_pkt)
+		vinfo->vout_device->fresh_tx_vsif_pkt(EOTF_T_NULL,
+			RGB_8BIT, NULL, true);
+}
+
+/* Already supplied by the amvideo object containing this implementation. */
+extern u32 get_video_enabled(void);
+
+static bool dv_injection_render_slot(struct dv_inj_slot *slot)
+{
+	const struct vinfo_s *vinfo;
+	int ret = 0;
+
+	if (!slot || !slot->valid)
+		return false;
+	vinfo = get_current_vinfo();
+	if (!vinfo || !vinfo->vout_device ||
+	    !vinfo->vout_device->fresh_tx_vsif_pkt ||
+	    !vinfo->vout_device->dv_info ||
+	    vinfo->vout_device->dv_info->ieeeoui != 0x00d046)
+		return false;
+
+	mutex_lock(&dv_injection_lock);
+	dv_injection_expand_pixels(slot);
+	if (dv_injection_write_canvas(vinfo))
+		ret = -EIO;
+	else if (always_send_vsif)
+		ret = dv_injection_send_vsif(vinfo);
+	if (!ret)
+		WRITE_ONCE(dv_injection_active, true);
+	mutex_unlock(&dv_injection_lock);
+	return ret == 0;
+}
+
+/*
+ * Called at display time (primary_render_frame): pick the metadata that
+ * belongs to the frame being scanned out and push it to the sink.  The
+ * kernel's own DV status is bookkeeping only; only the sink proves it.
+ */
+bool dv_injection_render_frame(struct vframe_s *vf)
+{
+	struct dv_inj_slot *slot;
+
+	if (!vf || !READ_ONCE(dv_injection_enable))
+		return false;
+	if (vdr_dm_data_source == 1) {
+		slot = &dv_inj_static_slot;
+	} else if (vf->src_fmt.fmt == VFRAME_SIGNAL_FMT_DOVI) {
+		slot = &dv_inj_pool[vf->index & (DV_INJ_POOL_SIZE - 1)];
+	} else {
+		return false;
+	}
+	return dv_injection_render_slot(slot);
+}
+EXPORT_SYMBOL(dv_injection_render_frame);
+
+static int dv_injection_enable_set(const char *val, const struct kernel_param *kp)
+{
+	struct kernel_param temporary = *kp;
+	bool enabled;
+	int ret;
+
+	temporary.arg = &enabled;
+	ret = param_set_bool(val, &temporary);
+	if (ret || (enabled && !dv_inj_ready))
+		return ret ? ret : -EAGAIN;
+	mutex_lock(&dv_injection_lock);
+	*(bool *)kp->arg = enabled;
+	if (!enabled)
+		dv_injection_deactivate();
+	mutex_unlock(&dv_injection_lock);
+	if (!enabled)
+		memset(dv_inj_pool, 0, sizeof(dv_inj_pool));
+	return 0;
+}
+
+/*
+ * Called from the video sink when a frame updates the source format.  The
+ * timer already drives the injection, so this only makes sure it runs.
+ */
+void dv_injection_process_frame(struct vframe_s *vf)
+{
+	const u8 *payload = NULL;
+	u32 payload_len = 0;
+	struct dv_inj_slot *slot;
+
+	if (!vf || !READ_ONCE(dv_injection_enable))
+		return;
+	if (vf->src_fmt.fmt != VFRAME_SIGNAL_FMT_DOVI)
+		return;
+	if (dv_injection_find_dv_sei(vf->src_fmt.sei_ptr, vf->src_fmt.sei_size,
+				     &payload, &payload_len))
+		return;
+	if (dv_injection_validate_metadata(payload, payload_len))
+		return;
+
+	slot = &dv_inj_pool[vf->index & (DV_INJ_POOL_SIZE - 1)];
+	mutex_lock(&dv_injection_lock);
+	if (!dv_injection_pack_bytes(slot->byte_data, &slot->num_pkts,
+				     payload, payload_len))
+		slot->valid = true;
+	mutex_unlock(&dv_injection_lock);
+}
+
+/*
+ * While injection is active the Dolby VSIF has to stay on the wire.  A
+ * profile 7 stream carries an HDR10 base layer, and the video path keeps
+ * re-sending that DRM packet roughly every 100 ms, which wins the race
+ * against our VSIF and leaves the sink in HDR10 (measured: the HDMI
+ * status flipped between HDR10 and DolbyVision-Std once per second).
+ */
+bool dv_injection_block_hdr10(void)
+{
+	return READ_ONCE(dv_injection_active) && READ_ONCE(dv_injection_enable);
+}
+EXPORT_SYMBOL(dv_injection_block_hdr10);
+
+/*
+ * Feed the DM metadata (raw bytes) from user space.
+ */
+int dv_injection_set_metadata(const u8 *data, u32 size)
+{
+	int ret = dv_injection_validate_metadata(data, size);
+
+	if (ret)
+		return ret;
+	mutex_lock(&dv_injection_lock);
+	ret = dv_injection_form_packets(data, size);
+	if (!ret) {
+		memcpy(dm_metadata, data, size);
+		dm_metadata_size = size;
+	}
+	mutex_unlock(&dv_injection_lock);
+	return ret;
+}
+
+static int dv_injection_param_set(const char *val,
+				   const struct kernel_param *kp)
+{
+	u8 parsed[DV_INJ_MAX_METADATA_SIZE];
+	int size, ret;
+
+	if (!val || strlen(val) >= sizeof(dv_metadata))
+		return -EINVAL;
+	mutex_lock(&dv_injection_lock);
+	size = dv_injection_parse_metadata(val, parsed);
+	if (size < 0) {
+		mutex_unlock(&dv_injection_lock);
+		return size;
+	}
+	ret = dv_injection_pack_bytes(dv_inj_static_slot.byte_data,
+				      &dv_inj_static_slot.num_pkts, parsed, size);
+	if (!ret) {
+		dv_inj_static_slot.valid = true;
+		strcpy(dv_metadata, val);
+		memcpy(dm_metadata, parsed, size);
+		dm_metadata_size = size;
+	}
+	mutex_unlock(&dv_injection_lock);
+	return ret;
+}
+
+static int dv_injection_param_get(char *buffer,
+				   const struct kernel_param *kp)
+{
+	char *buf = (char *)kp->arg;
+
+	if (!buf)
+		return 0;
+	return scnprintf(buffer, PAGE_SIZE, "%s", buf);
+}
+
+static const struct kernel_param_ops dv_metadata_ops = {
+	.set = dv_injection_param_set,
+	.get = dv_injection_param_get,
+};
+
+module_param_cb(dv_metadata, &dv_metadata_ops, &dv_metadata, 0644);
+MODULE_PARM_DESC(dv_metadata,
+		 "\n Dolby Vision DM metadata as hex string\n");
+
+static int __init dv_injection_init(void)
+{
+	dv_inj_ready = true;
+	dv_injection_log(1, "dv injection: module loaded\n");
+	return 0;
+}
+
+static void __exit dv_injection_exit(void)
+{
+	mutex_lock(&dv_injection_lock);
+	dv_injection_deactivate();
+	mutex_unlock(&dv_injection_lock);
+	dv_injection_log(1, "dv injection: module unloaded\n");
+}
+
+module_init(dv_injection_init);
+module_exit(dv_injection_exit);
+
+MODULE_DESCRIPTION("Amlogic TV-led Dolby Vision metadata injection");
+MODULE_AUTHOR("N1-CoreELEC project");
+MODULE_LICENSE("GPL");
