+/*
+ * The transport request is mirrored into the HDMI driver: it decides whether
+ * the output is programmed as RGB - which the metadata injection needs - or
+ * stays at the format the EDID and the source ask for.
+ */
+static void dv_inj_set_transport_requested(bool on)
+{
+	WRITE_ONCE(dv_inj_transport_requested, on);
+	hdmitx_set_dv_injection_policy(READ_ONCE(dv_injection_transport));
+	hdmitx_set_dv_injection_transport(on);
+}
+
+/*
+ * The tunnel mode decides what the AVI InfoFrame declares: RGB 8 bit makes
+ * the transmitter declare RGB444, every other mode makes it declare YUV422.
+ * The declaration and the samples on the wire have to agree, so the tunnel
+ * follows the transport policy.
+ */
+static enum mode_type dv_inj_vsif_tunnel_mode(void)
+{
+	if (READ_ONCE(dv_injection_transport) == 3)
+		return YUV422_BIT12;
+	if (READ_ONCE(dv_injection_transport) == 2)
+		return RGB_10_12BIT;
+	if (READ_ONCE(dv_injection_transport) == 4)
+		return YUV444_10_12BIT;
+	/* Policy 5 keeps the RGB 8 bit tunnel of the reference
+	 * implementation, which announces that mode while the samples
+	 * travel as YUV.
+	 */
+	return RGB_8BIT;
+}
+
+static int dv_injection_send_vsif(const struct vinfo_s *vinfo)
+{
+	struct dv_vsif_para vsif;
+
+	if (!vinfo || !vinfo->vout_device ||
+	    !vinfo->vout_device->fresh_tx_vsif_pkt ||
+	    !vinfo->vout_device->dv_info ||
+	    vinfo->vout_device->dv_info->ieeeoui != 0x00d046)
+		return -EINVAL;
+
+	memset(&vsif, 0, sizeof(vsif));
+	vsif.ver = 2;
+	vsif.length = 15;
+	vsif.vers.ver2.dobly_vision_signal = 1;	/* DV STD */
+	vsif.vers.ver2.low_latency = 0;
+
+	/* Keep the author's tunnel declaration (RGB 8-bit, AVI stays RGB/FULL).
+	 * The physical transport is forced to 422/12-bit inside the driver for
+	 * the injection path - swapping the enum here would also change the AVI
+	 * declaration, which is not what the reference does.
+	 */
+	/* R7: readiness and acceptance happen under one driver lock, so the
+	 * packet cannot be dropped between a check and the send.
+	 */
+	if (hdmitx_set_vsif_pkt_checked(EOTF_T_DOLBYVISION,
+					dv_inj_vsif_tunnel_mode(),
+					&vsif, false))
+		return -EAGAIN;
+	dv_injection_log(3, "dv injection: VSIF sent\n");
+	return 0;
+}
+
+/*
+ * Dump what the sink advertises for Dolby Vision.  Both the EMP path and
+ * the VSIF path depend on these values, so logging them turns a silent
+ * -EINVAL from send_emp() into something actionable.
+ */
+static void dv_injection_dump_sink_info(void)
+{
+	struct vinfo_s *vinfo = get_current_vinfo();
+	const struct dv_info *dv;
+
+	if (!vinfo || !vinfo->vout_device || !vinfo->vout_device->dv_info) {
+		pr_info("dv injection: sink reports no Dolby Vision EDID block\n");
+		return;
+	}
+	dv = vinfo->vout_device->dv_info;
+	pr_info("dv injection: sink DV oui=0x%06x ver=%u len=%u emp_cap=%u yuv422_12bit=%u 2160p60=%u dimming=%u dm=%u.%u\n",
+		dv->ieeeoui, dv->ver, dv->length, dv->dv_emp_cap,
+		dv->sup_yuv422_12bit, dv->sup_2160p60hz,
+		dv->sup_global_dimming, dv->dm_major_ver, dv->dm_minor_ver);
+}
+
+static bool dv_inj_ready;
+
+/* Called with dv_injection_lock held. Clearing ownership first permits
+ * the normal HDR/SDR producer to resume and the explicit DV-off packet
+ * restores the AVI colour/range state through the existing HDMI driver.
+ */
+static void dv_injection_deactivate(void)
+{
+	const struct vinfo_s *vinfo;
+
+	if (!dv_injection_active)
+		return;
+	WRITE_ONCE(dv_injection_active, false);
+	WRITE_ONCE(dv_inj_rt.ready, false);
+	vinfo = get_current_vinfo();
+	if (vinfo && vinfo->vout_device &&
+	    vinfo->vout_device->fresh_tx_vsif_pkt)
+		vinfo->vout_device->fresh_tx_vsif_pkt(EOTF_T_NULL,
+			RGB_8BIT, NULL, true);
+}
+
+/* Already supplied by the amvideo object containing this implementation. */
+extern u32 get_video_enabled(void);
+
+static void dv_injection_release_output(void)
+{
+	const struct vinfo_s *vinfo = get_current_vinfo();
+
+	if (!READ_ONCE(dv_injection_active))
+		return;
+	WRITE_ONCE(dv_injection_active, false);
+	if (vinfo && vinfo->vout_device && vinfo->vout_device->fresh_tx_vsif_pkt)
+		vinfo->vout_device->fresh_tx_vsif_pkt(EOTF_T_NULL, RGB_8BIT,
+						      NULL, true);
+}
+
+/*
+ * F5/F6: called from the video provider lifecycle (unreg, reset, light unreg).
+ * A new stream means every cached slot belongs to the previous one: bump the
+ * generation and hand the output back instead of letting a leftover frame
+ * keep the DV signal asserted.
+ */
+
+/*
+ * F3: the OSD can point the canvas at an external buffer or drop the fb
+ * mapping entirely.  Called from those paths to stop the interrupt writer
+ * before the target can change or disappear; the watchdog re-resolves after.
+ */
+u32 dv_injection_note_canvas_change(void)
+{
+	unsigned long flags;
+	u32 token;
+
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	WRITE_ONCE(dv_inj_rt.ready, false);
+	WRITE_ONCE(dv_inj_change_in_progress, true);
+	token = READ_ONCE(dv_inj_buffer_generation) + 1;
+	WRITE_ONCE(dv_inj_buffer_generation, token);
+	WRITE_ONCE(dv_inj_canvas_committed, false);
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	WRITE_ONCE(dv_inj_canvas_dirty, true);
+	return token;
+}
+
+/* R3: called once the driver has actually switched/committed the canvas.  The
+ * watchdog only re-binds a canvas that reached this point, so it cannot revive
+ * the address that was valid before the switch.
+ */
+
+/*
+ * R1: called by the driver when the output is torn down - HPD, a mode change
+ * or an internal reset sets hdev->ready = 0.  The transport contract no longer
+ * holds, so the module stops claiming the output until preparation succeeds
+ * again.
+ */
+void dv_injection_notify_output_lost(void)
+{
+	unsigned long flags;
+	bool wake = false;
+
+	dv_inj_diag_format(2);
+
+	/* One revocation block: everything the IRQ/side compares against is
+	 * written here, so a late write cannot resurrect a newer preparation.
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	WRITE_ONCE(dv_inj_mode_generation,
+		   READ_ONCE(dv_inj_mode_generation) + 1);
+	WRITE_ONCE(dv_inj_rt.ready, false);
+	WRITE_ONCE(dv_inj_accepting, false);
+	WRITE_ONCE(dv_inj_transport_ready, false);
+	*(bool *)&dv_injection_enable = false;
+	if (!READ_ONCE(dv_inj_pending) &&
+	    READ_ONCE(dv_inj_state) != DV_INJ_CLOSING &&
+	    READ_ONCE(dv_inj_user_wants)) {
+		if (READ_ONCE(dv_inj_state) != DV_INJ_PREPARING)
+			WRITE_ONCE(dv_inj_state, DV_INJ_PREPARING);
+		wake = true;
+	}
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+
+	if (wake)
+		schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(50));
+}
+EXPORT_SYMBOL(dv_injection_notify_output_lost);
+
+int dv_injection_note_canvas_committed(u32 token)
+{
+	unsigned long flags;
+	int ret = -EAGAIN;
+
+	/* The token check and the state it authorises are updated under one lock,
+	 * otherwise a completion for an older change could still be accepted.
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	if (READ_ONCE(dv_inj_buffer_generation) == token &&
+	    READ_ONCE(dv_inj_change_in_progress)) {
+		WRITE_ONCE(dv_inj_canvas_committed, true);
+		WRITE_ONCE(dv_inj_change_in_progress, false);
+		ret = 0;
+	}
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	if (!ret)
+		WRITE_ONCE(dv_inj_canvas_dirty, true);
+	return ret;
+}
+EXPORT_SYMBOL(dv_injection_note_canvas_committed);
+EXPORT_SYMBOL(dv_injection_note_canvas_change);
+
+
+/* R6: paired with dv_injection_new_stream() on the provider REG event. */
+
+/*
+ * Cache reset (PROVIDER_RESET) and light unregister: the provider stays
+ * registered in the vframe table - vf_light_unreg_provider() only forwards the
+ * event and the deinterlace/ppmgr paths forward RESET and keep going - so the
+ * stream is still running and no REG follows.  Drop the frame identity, release
+ * the output and let the worker prepare again when the user still wants it.
+ */
+void dv_injection_reset_stream(void)
+{
+	unsigned long flags;
+
+	mutex_lock(&dv_injection_lock);
+	/* Old frames must not be matched against the new cache state. */
+	WRITE_ONCE(dv_inj_generation, READ_ONCE(dv_inj_generation) + 1);
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	memset(dv_inj_pool, 0, sizeof(dv_inj_pool));
+	WRITE_ONCE(dv_inj_rt.ready, false);
+	WRITE_ONCE(dv_inj_accepting, false);
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+
+	if (READ_ONCE(dv_inj_state) != DV_INJ_IDLE ||
+	    READ_ONCE(dv_injection_enable)) {
+		/* Same closing transaction; it resumes when intent and the still
+		 * registered provider say so.
+		 */
+		dv_injection_begin_close_locked(true,
+					       READ_ONCE(dv_injection_enable));
+	} else if (READ_ONCE(dv_inj_user_wants) &&
+		   READ_ONCE(dv_inj_stream_running)) {
+		spin_lock_irqsave(&dv_inj_publish_lock, flags);
+		WRITE_ONCE(dv_inj_state, DV_INJ_PREPARING);
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	}
+	mutex_unlock(&dv_injection_lock);
+	schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(20));
+}
+EXPORT_SYMBOL(dv_injection_reset_stream);
+
+void dv_injection_stream_started(void)
+{
+	unsigned long flags;
+
+	mutex_lock(&dv_injection_lock);
+	WRITE_ONCE(dv_inj_stream_running, true);
+	/* A stop keeps the user's intent, so a new provider resumes on its own. */
+	if (READ_ONCE(dv_inj_state) == DV_INJ_IDLE &&
+	    READ_ONCE(dv_inj_user_wants)) {
+		spin_lock_irqsave(&dv_inj_publish_lock, flags);
+		WRITE_ONCE(dv_inj_session, READ_ONCE(dv_inj_session) + 1);
+		WRITE_ONCE(dv_inj_state, DV_INJ_PREPARING);
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	} else if (READ_ONCE(dv_inj_state) == DV_INJ_READY) {
+		WRITE_ONCE(dv_inj_generation, READ_ONCE(dv_inj_generation) + 1);
+		spin_lock_irqsave(&dv_inj_publish_lock, flags);
+		memset(dv_inj_pool, 0, sizeof(dv_inj_pool));
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	}
+	mutex_unlock(&dv_injection_lock);
+	schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(50));
+}
+EXPORT_SYMBOL(dv_injection_stream_started);
+
+void dv_injection_new_stream(void)
+{
+	/* Provider state is tracked no matter what injection is doing - a stop
+	 * while injection is off must not leave a stale "running".
+	 */
+	mutex_lock(&dv_injection_lock);
+	WRITE_ONCE(dv_inj_stream_running, false);
+	WRITE_ONCE(dv_inj_generation, READ_ONCE(dv_inj_generation) + 1);
+	if (READ_ONCE(dv_inj_state) != DV_INJ_IDLE ||
+	    READ_ONCE(dv_injection_enable)) {
+		/* R3: the same closing transaction as an explicit disable. */
+		dv_injection_begin_close_locked(true,
+					       READ_ONCE(dv_injection_enable));
+	}
+	mutex_unlock(&dv_injection_lock);
+	schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(20));
+}
+EXPORT_SYMBOL(dv_injection_new_stream);
+
+
+
+/*
+ * Interrupt context (vsync).  No mutex, no console_lock, no allocation:
+ * only the prepared pixels and the resolved canvas are touched.
+ */
+static void dv_inj_render_exit(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	if (dv_inj_render_busy > 0)
+		dv_inj_render_busy--;
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+}
+
+static unsigned long dv_injection_torn_frames;
+
+static void dv_injection_output_seen_bad_frame(void)
+{
+	WRITE_ONCE(dv_injection_torn_frames, dv_injection_torn_frames + 1);
+}
+
+static bool dv_injection_render_slot(struct dv_inj_slot *slot)
+{
+	const struct vinfo_s *vinfo;
+	struct dv_inj_slot *snap = &dv_inj_display_snapshot;
+	unsigned long flags;
+	int copy_failed;
+	bool ok;
+
+	if (!slot || !READ_ONCE(dv_injection_enable)) {
+		dv_inj_diag_commit(DV_INJ_DIAG_NO_ENABLE, slot);
+		return false;
+	}
+	/* R6: no provider, no takeover - a retained last frame must not keep the
+	 * DV signal alive after the stream stopped.
+	 */
+	if (!READ_ONCE(dv_inj_stream_running)) {
+		dv_inj_diag_commit(DV_INJ_DIAG_NO_STREAM, slot);
+		return false;
+	}
+	vinfo = get_current_vinfo();
+	if (!vinfo || !vinfo->vout_device ||
+	    !vinfo->vout_device->fresh_tx_vsif_pkt ||
+	    !vinfo->vout_device->dv_info ||
+	    vinfo->vout_device->dv_info->ieeeoui != 0x00d046) {
+		dv_inj_diag_commit(DV_INJ_DIAG_NO_SINK, slot);
+		return false;
+	}
+
+	/* Take a consistent private copy first: the decoder may be rewriting the
+	 * slot, and nothing may be written into the OSD before this check passes.
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	dv_inj_render_busy++;
+	ok = READ_ONCE(dv_inj_accepting) &&
+	     READ_ONCE(dv_inj_state) == DV_INJ_READY &&
+	     READ_ONCE(slot->valid) && READ_ONCE(dv_inj_rt.ready) &&
+	     READ_ONCE(dv_inj_transport_ready) &&
+	     READ_ONCE(dv_inj_stream_running) &&
+	     slot->generation == READ_ONCE(dv_inj_generation) &&
+	     slot->mode_gen == READ_ONCE(dv_inj_mode_generation);
+	if (ok) {
+		memcpy(snap->pixel_data, slot->pixel_data,
+		       sizeof(snap->pixel_data));
+		snap->num_pkts = slot->num_pkts;
+		snap->generation = slot->generation;
+		snap->mode_gen = slot->mode_gen;
+	}
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	if (!ok) {
+		spin_lock_irqsave(&dv_inj_publish_lock, flags);
+		dv_inj_render_busy--;
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+		dv_inj_diag_commit(DV_INJ_DIAG_STALE_SLOT, slot);
+		return false;
+	}
+
+	/* R2: the stream can stop between the snapshot and the OSD write; check
+	 * again here so nothing is written for a stream that already ended.
+	 */
+	if (!READ_ONCE(dv_inj_accepting) ||
+	    READ_ONCE(dv_inj_state) != DV_INJ_READY ||
+	    snap->generation != READ_ONCE(dv_inj_generation) ||
+	    snap->mode_gen != READ_ONCE(dv_inj_mode_generation) ||
+	    !READ_ONCE(dv_inj_stream_running)) {
+		dv_inj_diag_commit(DV_INJ_DIAG_STOPPED, snap);
+		dv_injection_release_output();
+		dv_inj_render_exit();
+		return false;
+	}
+	/* R3: the OSD copy runs under the publish lock so a canvas change or a
+	 * buffer release can drain it by taking the same lock.
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	copy_failed = dv_injection_copy_pixels(snap);
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	if (copy_failed) {
+		dv_inj_diag_commit(DV_INJ_DIAG_COPY_FAILED, snap);
+		dv_injection_release_output();
+		dv_inj_render_exit();
+		return false;
+	}
+	/* R2: the stream can stop between the snapshot and the commit. */
+	if (!READ_ONCE(dv_inj_accepting) ||
+	    READ_ONCE(dv_inj_state) != DV_INJ_READY ||
+	    snap->generation != READ_ONCE(dv_inj_generation) ||
+	    snap->mode_gen != READ_ONCE(dv_inj_mode_generation) ||
+	    !READ_ONCE(dv_inj_stream_running)) {
+		dv_inj_diag_commit(DV_INJ_DIAG_COMMIT_STOPPED, snap);
+		dv_injection_release_output();
+		dv_inj_render_exit();
+		return false;
+	}
+	if (always_send_vsif && dv_injection_send_vsif(vinfo)) {
+		dv_inj_diag_commit(DV_INJ_DIAG_VSIF_FAILED, snap);
+		dv_injection_release_output();
+		dv_inj_render_exit();
+		return false;
+	}
+	dv_inj_diag_commit(DV_INJ_DIAG_OK, snap);
+	WRITE_ONCE(dv_injection_active, true);
+	dv_inj_render_exit();
+	return true;
+}
+
+
+/*
+ * Called at display time (primary_render_frame): pick the metadata that
+ * belongs to the frame being scanned out and push it to the sink.  The
+ * kernel's own DV status is bookkeeping only; only the sink proves it.
+ */
+bool dv_injection_render_frame(struct vframe_s *vf)
+{
+	struct dv_inj_slot *slot;
+
+	if (!vf || !READ_ONCE(dv_injection_enable))
+		return false;
+	if (vdr_dm_data_source == 1) {
+		slot = &dv_inj_static_slot;
+	} else if (vf->src_fmt.fmt == VFRAME_SIGNAL_FMT_DOVI) {
+		slot = &dv_inj_pool[vf->index & (DV_INJ_POOL_SIZE - 1)];
+	} else {
+		/* SDR/HDR content or a stopped stream: hand the output back
+		 * instead of leaving the sink latched in Dolby Vision. */
+		dv_injection_release_output();
+		return false;
+	}
+	if (!dv_injection_render_slot(slot)) {
+		dv_injection_release_output();
+		return false;
+	}
+	return true;
+}
+EXPORT_SYMBOL(dv_injection_render_frame);
+
+/* True when the sink that is plugged in advertises Dolby Vision.  A sink that
+ * does not can never carry the metadata, so the output must not be switched
+ * into the RGB transport for it either.
+ */
+static bool dv_inj_sink_supports_dv(void)
+{
+	const struct vinfo_s *vinfo = get_current_vinfo();
+
+	return vinfo && vinfo->vout_device && vinfo->vout_device->dv_info &&
+		vinfo->vout_device->dv_info->ieeeoui == 0x00d046;
+}
+
+/*
+ * One preparation transaction, used by both the parameter write and the worker.
+ * The caller holds dv_injection_lock for the whole sequence: revoke and drain,
+ * request and program the transport, then - only after the programming is done -
+ * read the canvas and the mode generation it belongs to, and publish everything
+ * together under the publish lock.
+ */
+static int dv_inj_prepare_locked(void)
+{
+	struct dv_inj_candidate cand;
+	const struct vinfo_s *vinfo;
+	unsigned long flags;
+	u32 mode_gen;
+	int i, ret = -EAGAIN;
+
+	if (!READ_ONCE(dv_inj_user_wants) || READ_ONCE(dv_inj_pending))
+		return -EAGAIN;
+	if (READ_ONCE(dv_inj_state) == DV_INJ_READY &&
+	    READ_ONCE(dv_injection_enable))
+		return 0;
+
+	/* 1. Revoke new commits, drain the ones in flight, and only then hand the
+	 * output back - so a later failure cannot leave a half published state.
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	WRITE_ONCE(dv_inj_state, DV_INJ_PREPARING);
+	WRITE_ONCE(dv_inj_accepting, false);
+	WRITE_ONCE(dv_inj_rt.ready, false);
+	WRITE_ONCE(dv_inj_transport_ready, false);
+	*(bool *)&dv_injection_enable = false;
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	for (i = 0; i < 50 && READ_ONCE(dv_inj_render_busy) > 0; i++)
+		usleep_range(1000, 2000);
+	if (READ_ONCE(dv_inj_render_busy) > 0)
+		return -EBUSY;
+	dv_injection_deactivate();
+
+	/* 2. Wait for a live output.  The driver may notify from inside this
+	 * call; that only revokes state and advances the generation, which is
+	 * fine because the target is read afterwards.  The picture path itself
+	 * is never reprogrammed - see hdmitx_prepare_output_for_injection().
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	dv_inj_set_transport_requested(true);
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	ret = hdmitx_prepare_output_for_injection();
+	if (ret || !hdmitx_transport_is_live()) {
+		ret = ret ? ret : -EAGAIN;
+		goto undo;
+	}
+
+	/* 3. Read the generation first, then the target it belongs to. */
+	mode_gen = READ_ONCE(dv_inj_mode_generation);
+	vinfo = get_current_vinfo();
+	if (dv_injection_build_candidate(vinfo, &cand)) {
+		ret = -ENODEV;
+		goto undo;
+	}
+
+	/* 4. Verify and publish everything in one critical section: a mode change
+	 * or a close that lands afterwards can no longer be overwritten.
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	if (READ_ONCE(dv_inj_state) == DV_INJ_PREPARING &&
+	    !READ_ONCE(dv_inj_pending) &&
+	    READ_ONCE(dv_inj_user_wants) &&
+	    !READ_ONCE(dv_inj_change_in_progress) &&
+	    mode_gen == READ_ONCE(dv_inj_mode_generation) &&
+	    cand.gen == READ_ONCE(dv_inj_buffer_generation)) {
+		WRITE_ONCE(osd_pixel_offset, (unsigned int)(cand.page_bytes / 4));
+		WRITE_ONCE(dv_inj_rt.base, cand.base);
+		WRITE_ONCE(dv_inj_rt.page_bytes, (u32)cand.page_bytes);
+		WRITE_ONCE(dv_inj_rt.pages, cand.pages);
+		WRITE_ONCE(dv_inj_rt.ready, true);
+		WRITE_ONCE(dv_inj_transport_ready, true);
+		WRITE_ONCE(dv_inj_accepting, true);
+		WRITE_ONCE(dv_inj_mode_generation, mode_gen + 1);
+		WRITE_ONCE(dv_inj_state, DV_INJ_READY);
+		*(bool *)&dv_injection_enable = true;
+		spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+		WRITE_ONCE(dv_inj_prepare_failures, 0);
+		dv_injection_log(1, "dv injection: transport prepared\n");
+		dv_inj_diag_format(1);
+		return 0;
+	}
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	ret = -EAGAIN;
+
+undo:
+	/* A failed preparation is not a user decision: the display may simply not
+	 * be ready yet.  A mode change resets the OSD canvas, the sink may still be
+	 * coming back and the VSIF may not be queued yet.  Handing the output back
+	 * here would drop the RGB transport and leave the injection dead for good,
+	 * so the request is kept, the state stays PREPARING and the worker retries
+	 * until the display is ready.
+	 */
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	WRITE_ONCE(dv_inj_rt.ready, false);
+	WRITE_ONCE(dv_inj_accepting, false);
+	WRITE_ONCE(dv_inj_transport_ready, false);
+	*(bool *)&dv_injection_enable = false;
+	if (READ_ONCE(dv_inj_user_wants) && !READ_ONCE(dv_inj_pending) &&
+	    dv_inj_sink_supports_dv()) {
+		WRITE_ONCE(dv_inj_state, DV_INJ_PREPARING);
+	} else {
+		/* The user gave up while the preparation was running, or the
+		 * sink cannot do Dolby Vision at all: close for real and give the
+		 * output back.
+		 */
+		dv_inj_set_transport_requested(false);
+		WRITE_ONCE(dv_inj_state, DV_INJ_CLOSING);
+	}
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+
+	if (READ_ONCE(dv_inj_state) == DV_INJ_CLOSING) {
+		/* The user gave up: turn the injection off for real and give the
+		 * output back.
+		 */
+		dv_injection_deactivate();
+	}
+
+	if (READ_ONCE(dv_inj_state) == DV_INJ_PREPARING) {
+		WRITE_ONCE(dv_inj_prepare_failures,
+			   READ_ONCE(dv_inj_prepare_failures) + 1);
+		dv_injection_log(1,
+				 "dv injection: prepare deferred (%d), retrying\n",
+				 ret);
+		/* Make sure the worker is armed for the retry even when the
+		 * failure came from a path that does not keep it queued.
+		 */
+		schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(200));
+		return ret;
+	}
+
+	/* The output goes back to the format the EDID asks for.  The VSIF path
+	 * may be gone already, so the format restore does not depend on it.
+	 */
+	hdmitx_reconfigure_video_format();
+
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	WRITE_ONCE(dv_inj_pending, false);
+	WRITE_ONCE(dv_inj_state, DV_INJ_IDLE);
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	return ret;
+}
+
+/* Begin the closing transaction.  It is deliberately independent of the public
+ * enable bit: enabling is already false by the time this runs, yet the release,
+ * the slot clear and the physical restore still have to happen.
+ */
+/* Requires dv_injection_lock; the wrapper below takes it for external callers. */
+/* Requires dv_injection_lock; every shared field is written under the publish
+ * lock so the IRQ-side notify sees the transition atomically.
+ */
+/* Requires dv_injection_lock; every shared field is written under the publish
+ * lock so the IRQ-side notify sees the transition atomically.
+ */
+static void dv_injection_begin_close_locked(bool clear_pool, bool restore)
+{
+	unsigned long flags;
+	u32 gen;
+
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	/* A repeated close in the same session must merge its outstanding work.  A
+	 * later stop (public enable already false) passes restore == false, and
+	 * overwriting would drop a physical restore an earlier disable still owes.
+	 */
+	if (READ_ONCE(dv_inj_pending) &&
+	    READ_ONCE(dv_inj_pending_gen) == READ_ONCE(dv_inj_session)) {
+		clear_pool = clear_pool || READ_ONCE(dv_inj_pending_clear);
+		restore = restore || READ_ONCE(dv_inj_pending_restore);
+		gen = READ_ONCE(dv_inj_pending_gen);
+	} else {
+		/* New transaction: bind it to this session. */
+		gen = READ_ONCE(dv_inj_session);
+	}
+	*(bool *)&dv_injection_enable = false;
+	dv_inj_set_transport_requested(false);
+	WRITE_ONCE(dv_inj_transport_ready, false);
+	WRITE_ONCE(dv_inj_accepting, false);
+	WRITE_ONCE(dv_inj_rt.ready, false);
+	WRITE_ONCE(dv_inj_state, DV_INJ_CLOSING);
+	WRITE_ONCE(dv_inj_pending, true);
+	WRITE_ONCE(dv_inj_pending_clear, clear_pool);
+	WRITE_ONCE(dv_inj_pending_restore, restore);
+	WRITE_ONCE(dv_inj_pending_gen, gen);
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+}
+
+static void dv_injection_begin_close(bool clear_pool, bool restore)
+{
+	mutex_lock(&dv_injection_lock);
+	dv_injection_begin_close_locked(clear_pool, restore);
+	mutex_unlock(&dv_injection_lock);
+	schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(20));
+}
+
+/*
+ * F6: the display hook only runs when there is a frame on screen.  If
+ * playback stops while injection is on, nothing calls release_output() and
+ * the normal HDR producer stays blocked.  A small watchdog covers the
+ * "stopped, no new frame" case that the frame path cannot see.
+ */
+static void dv_inj_watchdog_fn(struct work_struct *work)
+{
+	unsigned long flags;
+	const struct vinfo_s *vinfo;
+	int ret = 0;
+
+	/* The whole transaction is decided under the control lock so an old
+	 * preparation cannot overwrite a newer close, and a close cannot run
+	 * against a session it does not own.
+	 */
+	mutex_lock(&dv_injection_lock);
+
+	if (READ_ONCE(dv_inj_pending)) {
+		if (READ_ONCE(dv_inj_pending_gen) != READ_ONCE(dv_inj_session)) {
+			WRITE_ONCE(dv_inj_pending, false);
+			dv_injection_log(1, "dv injection: stale pending dropped\n");
+			/* The output may still carry the RGB transport the injection
+			 * asked for.  Give it back unless a newer session owns it.
+			 */
+			if (!READ_ONCE(dv_inj_user_wants)) {
+				dv_inj_set_transport_requested(false);
+				dv_injection_deactivate();
+				hdmitx_reconfigure_video_format();
+			}
+		} else if (READ_ONCE(dv_inj_render_busy) > 0) {
+			mutex_unlock(&dv_injection_lock);
+			schedule_delayed_work(&dv_inj_watchdog,
+					      msecs_to_jiffies(20));
+			return;
+		} else {
+			/* R3: final DV-off after the last in-flight send. */
+			dv_injection_deactivate();
+			spin_lock_irqsave(&dv_inj_publish_lock, flags);
+			WRITE_ONCE(dv_inj_rt.ready, false);
+			if (READ_ONCE(dv_inj_pending_clear))
+				memset(dv_inj_pool, 0, sizeof(dv_inj_pool));
+			spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+			/* The transport request is gone: put the output back to the
+			 * format the EDID asks for.  This does not depend on the VSIF
+			 * path being available - a sink that went away must not keep
+			 * the output in the injection's transport.  The restore can
+			 * still fail, and then the transaction has to stay alive:
+			 * the picture must not keep the colour space of the
+			 * injection while the closing is already under way.
+			 */
+			ret = hdmitx_restore_output_format();
+			if (ret) {
+				pr_err("dv injection: closing restore failed (%d), deferring\n",
+				       ret);
+				mutex_unlock(&dv_injection_lock);
+				schedule_delayed_work(&dv_inj_watchdog,
+						      msecs_to_jiffies(200));
+				return;
+			}
+			/* Decide the outcome in the same critical section the IRQ
+			 * side uses, so a notification cannot interleave here.
+			 */
+			spin_lock_irqsave(&dv_inj_publish_lock, flags);
+			WRITE_ONCE(dv_inj_pending, false);
+			if (READ_ONCE(dv_inj_user_wants) &&
+			    READ_ONCE(dv_inj_stream_running)) {
+				WRITE_ONCE(dv_inj_session,
+					   READ_ONCE(dv_inj_session) + 1);
+				WRITE_ONCE(dv_inj_state, DV_INJ_PREPARING);
+			} else {
+				WRITE_ONCE(dv_inj_state, DV_INJ_IDLE);
+			}
+			spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+			dv_injection_log(1, "dv injection: closing transaction finished\n");
+			/* The restore path is where the output format goes back to
+			 * whatever the driver wants, so the trace pins that state
+			 * too: the last format record before playback is this one.
+			 */
+			dv_inj_diag_format(3);
+		}
+	}
+
+	/* A preparation is outstanding (cold start, resume after a stop, or after
+	 * an output loss): run it through the same helper the parameter uses.
+	 */
+	if (READ_ONCE(dv_inj_state) == DV_INJ_PREPARING &&
+	    !READ_ONCE(dv_inj_pending)) {
+		if (!READ_ONCE(dv_inj_user_wants)) {
+			spin_lock_irqsave(&dv_inj_publish_lock, flags);
+			dv_inj_set_transport_requested(false);
+			WRITE_ONCE(dv_inj_state, DV_INJ_IDLE);
+			spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+		} else {
+			ret = dv_inj_prepare_locked();
+			if (ret && ret != -EBUSY)
+				dv_injection_log(1,
+						 "dv injection: prepare deferred (%d)\n",
+						 ret);
+		}
+	}
+
+	/* Re-bind after a committed OSD change while injection is live. */
+	if (READ_ONCE(dv_inj_canvas_dirty) &&
+	    READ_ONCE(dv_inj_canvas_committed) &&
+	    !READ_ONCE(dv_inj_change_in_progress) &&
+	    READ_ONCE(dv_inj_state) == DV_INJ_READY) {
+		vinfo = get_current_vinfo();
+		WRITE_ONCE(dv_inj_canvas_dirty, false);
+		if (vinfo && dv_injection_resolve_canvas(vinfo)) {
+			dv_injection_log(1, "dv injection: canvas re-resolve failed\n");
+			WRITE_ONCE(dv_inj_rt.ready, false);
+		}
+	}
+
+	mutex_unlock(&dv_injection_lock);
+	/* A preparation that keeps failing is retried quickly: the display is
+	 * usually only a moment away from being ready again.  Afterwards the
+	 * worker goes back to its slow cadence.
+	 */
+	schedule_delayed_work(&dv_inj_watchdog,
+			      msecs_to_jiffies(READ_ONCE(dv_inj_prepare_failures) &&
+					       READ_ONCE(dv_inj_prepare_failures) < 20 ?
+					       200 : 1000));
+}
+
+static int dv_injection_enable_set(const char *val, const struct kernel_param *kp)
+{
+	struct kernel_param temporary = *kp;
+	unsigned long flags;
+	bool enabled;
+	int ret;
+
+	temporary.arg = &enabled;
+	ret = param_set_bool(val, &temporary);
+	if (ret)
+		return ret;
+
+	if (!enabled) {
+		/* Intent and the closing transaction are updated in one critical
+		 * section: an enable cannot slip in between them.
+		 */
+		mutex_lock(&dv_injection_lock);
+		*(bool *)kp->arg = false;
+		WRITE_ONCE(dv_inj_user_wants, false);
+		dv_injection_begin_close_locked(true, true);
+		mutex_unlock(&dv_injection_lock);
+		schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(20));
+		return 0;
+	}
+
+	if (!dv_inj_ready)
+		return -EAGAIN;
+
+	/* The control lock is held across the whole transaction, so a stale
+	 * preparation can never overwrite a disable or a newer close.
+	 */
+	mutex_lock(&dv_injection_lock);
+	WRITE_ONCE(dv_inj_user_wants, true);
+	if (READ_ONCE(dv_inj_state) == DV_INJ_CLOSING ||
+	    READ_ONCE(dv_inj_pending)) {
+		mutex_unlock(&dv_injection_lock);
+		schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(50));
+		return -EAGAIN;
+	}
+	/* Already prepared: a repeated enable must not disturb the running path. */
+	if (READ_ONCE(dv_inj_state) == DV_INJ_READY &&
+	    READ_ONCE(dv_injection_enable)) {
+		mutex_unlock(&dv_injection_lock);
+		return 0;
+	}
+	WRITE_ONCE(dv_inj_generation, READ_ONCE(dv_inj_generation) + 1);
+	WRITE_ONCE(dv_inj_session, READ_ONCE(dv_inj_session) + 1);
+	spin_lock_irqsave(&dv_inj_publish_lock, flags);
+	memset(dv_inj_pool, 0, sizeof(dv_inj_pool));
+	spin_unlock_irqrestore(&dv_inj_publish_lock, flags);
+	ret = dv_inj_prepare_locked();
+	if (ret) {
+		/* Roll back inside the same transaction: re-acquiring later could
+		 * clobber a legitimate enable that happened in between.
+		 */
+		dv_injection_log(0, "dv injection: preparation failed (%d)\n", ret);
+		*(bool *)kp->arg = false;
+		mutex_unlock(&dv_injection_lock);
+		return ret;
+	}
+	mutex_unlock(&dv_injection_lock);
+	schedule_delayed_work(&dv_inj_watchdog, msecs_to_jiffies(1000));
+	return 0;
+}
