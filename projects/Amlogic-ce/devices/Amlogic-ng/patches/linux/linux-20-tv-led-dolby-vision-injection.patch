+/* R7: the lock-free body is shared by the original void API and the new
+ * checked entry, so readiness and acceptance are decided under one lock.
+ */
+void hdmitx_set_vsif_pkt(enum eotf_type type, enum mode_type tunnel_mode,
+			 struct dv_vsif_para *data, bool signal_sdr)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hdmitx_device.edid_spinlock, flags);
+	__hdmitx_set_vsif_pkt_locked(type, tunnel_mode, data, signal_sdr);
+	spin_unlock_irqrestore(&hdmitx_device.edid_spinlock, flags);
+}
+EXPORT_SYMBOL(hdmitx_set_vsif_pkt);
+
+int hdmitx_set_vsif_pkt_checked(enum eotf_type type, enum mode_type tunnel_mode,
+				struct dv_vsif_para *data, bool signal_sdr)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&hdmitx_device.edid_spinlock, flags);
+	if (hdmitx_device.bist_lock || !hdmitx_device.ready) {
+		spin_unlock_irqrestore(&hdmitx_device.edid_spinlock, flags);
+		return -EAGAIN;
+	}
+	__hdmitx_set_vsif_pkt_locked(type, tunnel_mode, data, signal_sdr);
+	spin_unlock_irqrestore(&hdmitx_device.edid_spinlock, flags);
+	return 0;
+}
+EXPORT_SYMBOL(hdmitx_set_vsif_pkt_checked);
